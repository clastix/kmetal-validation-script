# setup.env - description of a kMetal under cluster, read by kmetal-validate.
#
# The file is sourced by bash. Copy it to setup.env, describe the customer's nodes and
# networks, then run:
#
#   ./kmetal-validate check-env                 # parse and print, no node is contacted
#   ./kmetal-validate undercluster              # SSH checks on every node
#   ./kmetal-validate kmetal --kubeconfig FILE  # platform validation + e2e
#
# Addresses, VLANs and CIDRs below are random examples; replace every one of them.

# --- SSH from the bootstrap machine -------------------------------------------------
# Every node is reached on its mgmt address. The user needs passwordless sudo.
SSH_USER=clastix
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"

# SSH_OPTS="$SSH_OPTS -J jump@bastion.example"       # through a jump host
# SSH_SUDO="sudo -n"                                  # "" when SSH_USER is root

# --- Size (cross-checked against NODES) ---------------------------------------------
# Minimum lab: 1 control plane + 2 workers. Production: 3 control planes + 3 or more workers.
CP_COUNT=1
WORKER_COUNT=2

# --- Networks carrying a node IP ----------------------------------------------------
# mgmt, tenant and overlay are mandatory names; add others (e.g. storage) as needed.
# The columns of NODES follow this order.
NETWORKS="mgmt tenant overlay"

# Interface name on the nodes (a VLAN sub-interface, a bond, or a NIC).
NET_IFACE=([mgmt]=bond0.577 [tenant]=bond0.2308 [overlay]=bond0.2817)
# VLAN ID the interface must carry. Empty or 0: the interface is not a VLAN device.
NET_VLAN=([mgmt]=577 [tenant]=2308 [overlay]=2817)
# Network of each VLAN. The networks must not overlap each other, the primary CNI pod
# CIDR, the service CIDR, kubeOVN.podCIDR or 100.64.0.0/16.
NET_CIDR=(  [mgmt]=10.55.227.0/24 [tenant]=10.55.91.0/24 [overlay]=10.55.172.0/24)
# Optional: expected MTU. Above 1500 a do-not-fragment ping checks it end to end.
NET_MTU=(  [mgmt]=9100 [tenant]=9100 [overlay]=9100 )

# The only network allowed to reach the internet from the nodes.
NET_INTERNET=mgmt
# Networks whose absence is a warning rather than a failure.
OPTIONAL_NETWORKS=""

# --- Provider networks: workers only, the interface carries no IP -------------------
# One or more; each becomes an OVN bridge for tenant egress and EIPs.
PROVIDER_NETWORKS="provider"
PROV_IFACE=( [provider]=bond0.1259)
PROV_VLAN=(  [provider]=1259 )

# --- Nodes --------------------------------------------------------------------------
# name           role    <one column per NETWORKS entry, "-" when the node has none>
# Addresses may carry /prefix; without it the prefix of NET_CIDR is expected.
# Control planes without overlay are reported as INFO: the tunnel runs on network nodes.
NODES="
kmetal-controller       cp      10.55.227.60   10.55.91.60   10.55.172.60            
#cp-02            cp      192.0.2.11      198.51.100.11   -               203.0.113.102
#cp-03            cp      192.0.2.12      198.51.100.12   -               203.0.113.103
kmetal-worker-01        worker  10.55.227.71   10.55.91.71   10.55.172.71   
kmetal-worker-02        worker  10.55.227.84   10.55.91.84   10.55.172.84
"

# Kube-OVN central nodes. Read from the KMetal resource when a kubeconfig works;
# set it here to check the under cluster before kMetal is installed.
CENTRAL_NODES="kmetal-worker-01 kmetal-worker-02"

# --- Internet probes ----------------------------------------------------------------
INTERNET_PROBE_URL=https://ghcr.io
INTERNET_PROBE_IP=1.1.1.1
DNS_PROBE=ghcr.io
# UDP port of the temporary tunnel built between two overlay nodes (not Kube-OVN's 6081).
ENCAP_TEST_PORT=6090

# --- kmetal: end-to-end test ---------------------------------------------------------
# Both environments get this same subnet: the overlap is intentional.
E2E_SUBNET_CIDR=10.250.0.0/24
# Empty: kubevirt-standard, then kubevirt-expert, then kubevirt-kubeadm, then the first found.
E2E_CLUSTERCLASS=""
# Empty: the first entry of spec.clusterClass.values.osArtifact.tags.
E2E_K8S_VERSION=""
E2E_MACHINE_SIZE=small
E2E_DATASTORE=default
E2E_WORKERS_A=2
E2E_WORKERS_B=1
# Images pulled by the test pods; point them at a mirror on air-gapped sites.
TEST_IMAGE=nginx:alpine
PROBE_IMAGE=busybox:1.36
CURL_IMAGE=curlimages/curl:8.10.1
# How to reach tenant API servers: auto (direct, else SSH to a control plane), direct, ssh.
TENANT_ACCESS=auto
# Node that runs tenant kubectl in ssh mode (default: the first control plane).
# TENANT_KUBECTL_NODE=cp-01
# Where an EIP is curled from: local, or a node name.
EIP_PROBE_FROM=local
