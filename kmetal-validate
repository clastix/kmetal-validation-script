#!/usr/bin/env bash
#
# kmetal-validate - validate a kMetal under cluster and a kMetal 1.0.0 installation.
#
#   kmetal-validate [-e setup.env] [--kubeconfig FILE] <command> [flags]
#
# Commands:
#   undercluster   Check nodes, VLANs, addressing, MTU, kernel encapsulation and egress
#                  over SSH, as declared in setup.env.
#   kmetal         Platform validation (admin-guide/installation/platform-validation)
#                  plus an end-to-end tenant test. Needs an admin kubeconfig.
#   cleanup        Remove leftovers of a run: --run-id ID.
#   check-env      Parse and validate setup.env, print the node table, run nothing.
#   help           Show this help.
#
# Run `kmetal-validate help` for every flag.

set -o pipefail

readonly SCRIPT_VERSION="0.1.0"
readonly TARGET_KMETAL="1.0"
readonly LABEL_KEY="kmetal-validate/run-id"

readonly NS_FLUX=kmetal-flux
readonly NS_METALLB=kmetal-metallb
readonly NS_KUBEVIRT=system-kubevirt
readonly NS_CAPI=kmetal-capi-providers
readonly NS_IMAGES=kmetal-image-builder

# ---------------------------------------------------------------------------
# Defaults. setup.env overrides any of them.
# ---------------------------------------------------------------------------
SSH_USER=ubuntu
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"
SSH_SUDO="sudo -n"
CP_COUNT=""
WORKER_COUNT=""
NETWORKS=""
declare -A NET_IFACE=() NET_VLAN=() NET_CIDR=() NET_MTU=()
NET_INTERNET=mgmt
OPTIONAL_NETWORKS=""
PROVIDER_NETWORKS=""
declare -A PROV_IFACE=() PROV_VLAN=()
declare -A PROV_SUBNET_VLAN=() PROV_VLAN_BY_IFACE=()
NODES=""
CENTRAL_NODES=""
INTERNET_PROBE_URL=https://ghcr.io
INTERNET_PROBE_IP=1.1.1.1
DNS_PROBE=ghcr.io
ENCAP_TEST_PORT=6090

KMETAL_NAMESPACE=kmetal-operator-system
KMETAL_RELEASE=kmetal-operator

E2E_SUBNET_CIDR=10.250.0.0/24
E2E_CLUSTERCLASS=""
E2E_K8S_VERSION=""
E2E_MACHINE_SIZE=small
E2E_DATASTORE=default
E2E_WORKERS_A=2
E2E_WORKERS_B=1
E2E_TENANT1_WORKERS=1
E2E_TENANT2_WORKERS=2
E2E_POD_CIDR=10.93.0.0/16
E2E_SVC_CIDR=10.96.0.0/16
TEST_IMAGE=nginx:alpine
PROBE_IMAGE=busybox:1.36
CURL_IMAGE=curlimages/curl:8.10.1
TENANT_ACCESS=auto
TENANT_KUBECTL_NODE=""
EIP_PROBE_FROM=local

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    C_R=$'\e[31m' C_G=$'\e[32m' C_Y=$'\e[33m' C_B=$'\e[1;34m' C_D=$'\e[2m' C_0=$'\e[0m'
else
    C_R="" C_G="" C_Y="" C_B="" C_D="" C_0=""
fi

PASS_N=0 WARN_N=0 FAIL_N=0
FAILS=() WARNS=()
CUR_GROUP=""

section() { CUR_GROUP=$1; printf '\n%s== %s ==%s\n' "$C_B" "$*" "$C_0"; }
pass()    { PASS_N=$((PASS_N + 1)); printf '  %sPASS%s %s\n' "$C_G" "$C_0" "$*"; }
warn()    { WARN_N=$((WARN_N + 1)); WARNS+=("[$CUR_GROUP] $*"); printf '  %sWARN%s %s\n' "$C_Y" "$C_0" "$*"; }
fail()    { FAIL_N=$((FAIL_N + 1)); FAILS+=("[$CUR_GROUP] $*"); printf '  %sFAIL%s %s\n' "$C_R" "$C_0" "$*"; }
info()    { printf '  %sINFO%s %s\n' "$C_D" "$C_0" "$*"; }
detail()  { sed -e 's/^/         /'; }
die()     { printf '%sERROR%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 3; }

summary() {
    section "summary"
    printf '  %d passed, %s%d warnings%s, %s%d failures%s\n' \
        "$PASS_N" "$C_Y" "$WARN_N" "$C_0" "$C_R" "$FAIL_N" "$C_0"
    local m
    for m in "${FAILS[@]}"; do printf '  %sFAIL%s %s\n' "$C_R" "$C_0" "$m"; done
    for m in "${WARNS[@]}"; do printf '  %sWARN%s %s\n' "$C_Y" "$C_0" "$m"; done
    if [[ -n ${RUN_ID:-} && ${#CLEANUP_STACK[@]} -gt 0 && $KEEP -eq 1 ]]; then
        printf '\n  Test resources kept. Remove them with:\n    %s cleanup --run-id %s\n' "$0" "$RUN_ID"
    fi
}

exit_code() {
    if ((FAIL_N > 0)); then echo 1
    elif ((WARN_N > 0)); then echo 2
    else echo 0
    fi
}

usage() {
    cat <<EOF
kmetal-validate $SCRIPT_VERSION - validation of a kMetal $TARGET_KMETAL under cluster and platform

Usage:
  kmetal-validate [global flags] <command> [flags]

Commands:
  undercluster   Node, VLAN, addressing, MTU, encapsulation and egress checks over SSH
  kmetal         Platform validation and end-to-end tenant tests (admin kubeconfig)
  cleanup        Remove the resources of a run (requires --run-id)
  check-env      Validate setup.env and print the parsed node table
  help           This help

Help on check groups:
  kmetal-validate undercluster help           list the undercluster groups
  kmetal-validate kmetal help                 list the kmetal groups
  kmetal-validate <command> help <group>      explain one group

Global flags:
  -e, --env FILE           setup.env to load (default ./setup.env; optional for kmetal)
      --kubeconfig FILE    kubeconfig of the under cluster (default \$KUBECONFIG)
      --only g1,g2         run only these check groups
      --skip g1,g2         skip these check groups
      --keep               keep test resources (print the cleanup command instead)
  -v, --verbose            trace every command (set -x)

kmetal flags:
      --no-e2e             skip the end-to-end groups (e2e, e2e-tenants)
      --e2e-only           run only the end-to-end groups
      --force-e2e          run e2e even when earlier groups failed
      --timeout-cluster D  wait for tenant clusters (default 30m; s/m/h suffix)

cleanup flags:
      --run-id ID          run ID printed by the run to clean up

Check groups (details: kmetal-validate <command> help <group>):
  undercluster: connectivity topology hardware os interfaces netplan addressing mesh internet encap
  kmetal:       platform operator metallb storage nodes providers tenancy capi kubevirt crds e2e e2e-tenants

Exit codes: 0 all passed, 1 at least one failure, 2 warnings only, 3 usage or setup error.
EOF
}

# ---------------------------------------------------------------------------
# Generic helpers
# ---------------------------------------------------------------------------
require() {
    local c missing=()
    for c in "$@"; do command -v "$c" >/dev/null 2>&1 || missing+=("$c"); done
    ((${#missing[@]} == 0)) || die "missing required tools: ${missing[*]}"
}

# to_seconds 30m|900s|1h|900
to_seconds() {
    local v=$1
    case $v in
        *h) echo $(( ${v%h} * 3600 )) ;;
        *m) echo $(( ${v%m} * 60 )) ;;
        *s) echo "${v%s}" ;;
        *)  echo "$v" ;;
    esac
}

# poll TIMEOUT_S INTERVAL_S cmd... - true as soon as cmd succeeds
poll() {
    local timeout=$1 interval=$2; shift 2
    local end=$((SECONDS + timeout))
    while :; do
        "$@" && return 0
        ((SECONDS >= end)) && return 1
        sleep "$interval"
    done
}

join_by() { local IFS=$1; shift; echo "$*"; }
joinc() { local out="" x; for x in "$@"; do out+="${out:+, }$x"; done; echo "$out"; }

in_list() { # in_list WORD "space separated list"
    local w
    for w in $2; do [[ $w == "$1" ]] && return 0; done
    return 1
}

want() {
    local g=$1
    if [[ -n $ONLY && ",$ONLY," != *",$g,"* ]]; then return 1; fi
    [[ ",$SKIP," == *",$g,"* ]] && return 1
    return 0
}

run_group() { # run_group NAME FUNCTION
    want "$1" || return 0
    section "$1"
    "$2"
}

# ---------------------------------------------------------------------------
# IPv4 math
# ---------------------------------------------------------------------------
valid_ip() {
    local ip=$1 o
    [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for o in "${BASH_REMATCH[@]:1}"; do ((10#$o <= 255)) || return 1; done
}

valid_cidr() {
    [[ $1 == */* ]] || return 1
    valid_ip "${1%/*}" || return 1
    [[ ${1#*/} =~ ^[0-9]+$ ]] && ((${1#*/} <= 32))
}

ip2int() {
    local IFS=. o
    read -ra o <<<"$1"
    echo $(( (10#${o[0]} << 24) + (10#${o[1]} << 16) + (10#${o[2]} << 8) + 10#${o[3]} ))
}

int2ip() {
    local n=$1
    echo "$(( (n >> 24) & 255 )).$(( (n >> 16) & 255 )).$(( (n >> 8) & 255 )).$(( n & 255 ))"
}

# cidr_range CIDR -> "lo hi"
cidr_range() {
    local n len mask
    n=$(ip2int "${1%/*}")
    len=${1#*/}
    if ((len == 0)); then mask=0; else mask=$(( (0xFFFFFFFF << (32 - len)) & 0xFFFFFFFF )); fi
    echo "$(( n & mask )) $(( (n & mask) | (~mask & 0xFFFFFFFF) ))"
}

# range_lohi "a-b" | "a/len" | "a" -> "lo hi"
range_lohi() {
    local r=${1// /}
    if [[ $r == *-* ]]; then
        echo "$(ip2int "${r%-*}") $(ip2int "${r#*-}")"
    elif [[ $r == */* ]]; then
        cidr_range "$r"
    else
        local n; n=$(ip2int "$r"); echo "$n $n"
    fi
}

cidr_contains() { # cidr_contains CIDR IP
    local lo hi n
    read -r lo hi < <(cidr_range "$1")
    n=$(ip2int "$2")
    ((n >= lo && n <= hi))
}

range_contains() { # range_contains RANGE IP
    local lo hi n
    read -r lo hi < <(range_lohi "$1")
    n=$(ip2int "$2")
    ((n >= lo && n <= hi))
}

ranges_overlap() { # ranges_overlap R1 R2 (each a-b, cidr or ip)
    local a b c d
    read -r a b < <(range_lohi "$1")
    read -r c d < <(range_lohi "$2")
    ((a <= d && c <= b))
}

range_within() { # range_within INNER OUTER
    local a b c d
    read -r a b < <(range_lohi "$1")
    read -r c d < <(range_lohi "$2")
    ((a >= c && b <= d))
}

cidr_is_canonical() {
    local lo _
    read -r lo _ < <(cidr_range "$1")
    [[ $(int2ip "$lo") == "${1%/*}" ]]
}

# ---------------------------------------------------------------------------
# setup.env parsing
# ---------------------------------------------------------------------------
NODE_LIST=()
declare -A NODE_ROLE=() NODE_ADDR=()
NETS=()
HAVE_ENV=0

addr_ip()  { echo "${1%/*}"; }
addr_len() { # addr_len NODE_VALUE NETWORK
    if [[ $1 == */* ]]; then echo "${1#*/}"; else echo "${NET_CIDR[$2]#*/}"; fi
}

nodes_with_role() { # nodes_with_role cp|worker
    local n
    for n in "${NODE_LIST[@]}"; do [[ ${NODE_ROLE[$n]} == "$1" ]] && echo "$n"; done
}

first_node() { nodes_with_role "$1" | head -n1; }

mgmt_ip() { addr_ip "${NODE_ADDR[$1|mgmt]}"; }

load_env() {
    local errs=() net i line name role v ip cols seen_ips=() n
    read -ra NETS <<<"$NETWORKS"
    ((${#NETS[@]} > 0)) || errs+=("NETWORKS is empty")
    for net in mgmt tenant overlay; do
        in_list "$net" "$NETWORKS" || errs+=("NETWORKS must contain '$net'")
    done
    for net in "${NETS[@]}"; do
        [[ -n ${NET_IFACE[$net]:-} ]] || errs+=("NET_IFACE[$net] is not set")
        if [[ -z ${NET_CIDR[$net]:-} ]]; then
            errs+=("NET_CIDR[$net] is not set")
        elif ! valid_cidr "${NET_CIDR[$net]}"; then
            errs+=("NET_CIDR[$net]=${NET_CIDR[$net]} is not a valid CIDR")
        elif ! cidr_is_canonical "${NET_CIDR[$net]}"; then
            errs+=("NET_CIDR[$net]=${NET_CIDR[$net]} is not a network address")
        fi
        v=${NET_VLAN[$net]:-}
        [[ -z $v || $v =~ ^[0-9]+$ ]] || errs+=("NET_VLAN[$net]=$v is not a number")
    done
    in_list "$NET_INTERNET" "$NETWORKS" || errs+=("NET_INTERNET=$NET_INTERNET is not in NETWORKS")
    for net in $PROVIDER_NETWORKS; do
        [[ -n ${PROV_IFACE[$net]:-} ]] || errs+=("PROV_IFACE[$net] is not set")
    done

    NODE_LIST=()
    while IFS= read -r line; do
        line=${line%%#*}
        [[ -z ${line//[[:space:]]/} ]] && continue
        read -ra cols <<<"$line"
        if ((${#cols[@]} != ${#NETS[@]} + 2)); then
            errs+=("NODES row '${line}' has ${#cols[@]} columns, expected $(( ${#NETS[@]} + 2 )) (name role ${NETS[*]})")
            continue
        fi
        name=${cols[0]} role=${cols[1]}
        [[ $role == cp || $role == worker ]] || errs+=("node $name: role '$role' must be cp or worker")
        [[ -n ${NODE_ROLE[$name]:-} ]] && errs+=("node $name is listed twice")
        NODE_LIST+=("$name")
        NODE_ROLE[$name]=$role
        for i in "${!NETS[@]}"; do
            net=${NETS[$i]}
            v=${cols[$((i + 2))]}
            NODE_ADDR[$name|$net]=$v
            [[ $v == - ]] && continue
            ip=$(addr_ip "$v")
            if ! valid_ip "$ip"; then
                errs+=("node $name: $net address '$v' is not an IPv4 address")
                continue
            fi
            if valid_cidr "${NET_CIDR[$net]:-x}" && ! cidr_contains "${NET_CIDR[$net]}" "$ip"; then
                errs+=("node $name: $net address $ip is outside ${NET_CIDR[$net]}")
            fi
            for n in "${seen_ips[@]}"; do
                [[ $n == "$ip" ]] && errs+=("address $ip is used twice")
            done
            seen_ips+=("$ip")
        done
        [[ ${NODE_ADDR[$name|mgmt]} == - ]] && errs+=("node $name: a mgmt address is required (SSH target)")
    done <<<"$NODES"

    ((${#NODE_LIST[@]} > 0)) || errs+=("NODES is empty")
    local ncp nwk
    ncp=$(nodes_with_role cp | wc -l)
    nwk=$(nodes_with_role worker | wc -l)
    [[ -z $CP_COUNT || $CP_COUNT == "$ncp" ]] || errs+=("CP_COUNT=$CP_COUNT but NODES lists $ncp control planes")
    [[ -z $WORKER_COUNT || $WORKER_COUNT == "$nwk" ]] || errs+=("WORKER_COUNT=$WORKER_COUNT but NODES lists $nwk workers")

    if ((${#errs[@]})); then
        printf '%sERROR%s setup.env is invalid:\n' "$C_R" "$C_0" >&2
        printf '  - %s\n' "${errs[@]}" >&2
        exit 3
    fi
    read -ra SSH_ARGS <<<"$SSH_OPTS"
    for net in $PROVIDER_NETWORKS; do
        [[ -n ${PROV_VLAN[$net]:-} && ${PROV_VLAN[$net]} != 0 ]] && PROV_VLAN_BY_IFACE[${PROV_IFACE[$net]}]=${PROV_VLAN[$net]}
    done
    HAVE_ENV=1
}

print_env() {
    section "setup.env"
    printf '  %-20s %-7s' NODE ROLE
    local net n
    for net in "${NETS[@]}"; do printf ' %-18s' "$net(${NET_IFACE[$net]})"; done
    printf '\n'
    for n in "${NODE_LIST[@]}"; do
        printf '  %-20s %-7s' "$n" "${NODE_ROLE[$n]}"
        for net in "${NETS[@]}"; do printf ' %-18s' "${NODE_ADDR[$n|$net]}"; done
        printf '\n'
    done
    for net in "${NETS[@]}"; do
        info "network $net: iface ${NET_IFACE[$net]}, VLAN ${NET_VLAN[$net]:-none}, CIDR ${NET_CIDR[$net]}${NET_MTU[$net]:+, MTU ${NET_MTU[$net]}}"
    done
    for net in $PROVIDER_NETWORKS; do
        info "provider $net: iface ${PROV_IFACE[$net]}, VLAN ${PROV_VLAN[$net]:-none}, workers only, no IP"
    done
}

# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------
SSH_ARGS=()

# node_exec NODE < script   - run a bash script as root on NODE
node_exec() {
    # shellcheck disable=SC2086
    ssh "${SSH_ARGS[@]}" "$SSH_USER@$(mgmt_ip "$1")" "$SSH_SUDO bash -s"
}

# node_cmd NODE CMD - run a command string as SSH_USER (no sudo)
node_cmd() {
    ssh "${SSH_ARGS[@]}" "$SSH_USER@$(mgmt_ip "$1")" "$2"
}

# run_on_nodes TAG NODE... - runs $WORK/TAG.NODE.sh on every node in parallel;
# output in $WORK/TAG.NODE.out, exit code in $WORK/TAG.NODE.rc
run_on_nodes() {
    local tag=$1 n; shift
    for n in "$@"; do
        (
            node_exec "$n" <"$WORK/$tag.$n.sh" >"$WORK/$tag.$n.out" 2>"$WORK/$tag.$n.err"
            echo $? >"$WORK/$tag.$n.rc"
        ) &
    done
    wait
}

# ---------------------------------------------------------------------------
# Cleanup registry
# ---------------------------------------------------------------------------
CLEANUP_STACK=()
CLEANUP_DONE=0
KEEP=0

register_cleanup() { CLEANUP_STACK+=("$*"); }

run_cleanup() {
    ((CLEANUP_DONE)) && return 0
    CLEANUP_DONE=1
    ((${#CLEANUP_STACK[@]})) || return 0
    if ((KEEP)); then
        section "cleanup"
        info "--keep: ${#CLEANUP_STACK[@]} cleanup steps skipped (run ID $RUN_ID)"
        return 0
    fi
    section "cleanup"
    local i
    for ((i = ${#CLEANUP_STACK[@]} - 1; i >= 0; i--)); do
        eval "${CLEANUP_STACK[$i]}" || warn "cleanup step failed: ${CLEANUP_STACK[$i]}"
    done
    info "cleanup of run $RUN_ID finished"
}

on_exit() {
    run_cleanup
    [[ -n ${WORK:-} && -d $WORK ]] && rm -rf "$WORK"
}

# ---------------------------------------------------------------------------
# kubectl helpers
# ---------------------------------------------------------------------------
HAVE_KUBE=0
KM_JSON=""
KM_NAME=""

kube_ok() { kubectl get --raw /readyz --request-timeout=10s >/dev/null 2>&1; }

load_km() {
    KM_JSON=$(kubectl get km -o json 2>/dev/null | jq -c '.items[0] // empty')
    [[ -n $KM_JSON ]] || return 1
    KM_NAME=$(jq -r .metadata.name <<<"$KM_JSON")
}

km()  { [[ -n $KM_JSON ]] && jq -r "($1) // empty" <<<"$KM_JSON"; }
kmj() { [[ -n $KM_JSON ]] && jq -c "($1) // empty" <<<"$KM_JSON"; }

# table_col COLUMN kubectl-get-args... - value of a printer column (first row)
table_col() {
    local col=$1; shift
    kubectl get "$@" 2>/dev/null | awk -v c="$col" '
        NR == 1 { h = " " $0 " "; p = index(h, " " c " "); next }
        p      { s = substr($0, p); sub(/^ +/, "", s); split(s, a, " "); print a[1]; exit }'
}

labels() { jq -c --arg k "$LABEL_KEY" --arg v "$RUN_ID" '{($k): $v}' -n; }

kapply() { kubectl apply -f - >/dev/null; }

# is_ready KIND NAME NAMESPACE - Ready condition, .status.ready or READY column
is_ready() {
    local j
    j=$(kubectl get "$1" "$2" -n "$3" -o json 2>/dev/null) || return 1
    jq -e '(([.status.conditions[]? | select(.type == "Ready") | .status] | first) == "True")
           or (.status.ready == true)' <<<"$j" >/dev/null && return 0
    [[ $(table_col READY "$1" "$2" -n "$3") == True ]]
}

pod_phase() { kubectl get pod "$2" -n "$1" -o jsonpath='{.status.phase}' 2>/dev/null; }

# wait_pod_done NS NAME TIMEOUT - 0 Succeeded, 1 Failed, 2 timeout
wait_pod_done() {
    local end=$((SECONDS + $3)) ph
    while ((SECONDS < end)); do
        ph=$(pod_phase "$1" "$2")
        [[ $ph == Succeeded ]] && return 0
        [[ $ph == Failed ]] && return 1
        sleep 3
    done
    return 2
}

pod_diag() { # pod_diag NS POD [PVC]
    {
        kubectl logs -n "$1" "$2" --tail=10 2>&1
        kubectl get events -n "$1" --sort-by=.lastTimestamp 2>/dev/null | tail -n 8
        [[ -n ${3:-} ]] && kubectl describe pvc -n "$1" "$3" 2>/dev/null | sed -n '/^Events:/,$p' | tail -n 6
    } | detail
}

readonly PLACEMENT_COMPUTE='{"affinity":{"nodeAffinity":{"requiredDuringSchedulingIgnoredDuringExecution":{"nodeSelectorTerms":[{"matchExpressions":[{"key":"node-role.kubernetes.io/compute","operator":"Exists"}]}]}}}}'

# pod_json NAME NS IMAGE PLACEMENT_JSON CLAIM CMD
pod_json() {
    jq -n --arg n "$1" --arg ns "$2" --arg img "$3" --argjson pl "$4" --arg claim "$5" \
        --arg cmd "$6" --argjson lb "$(labels)" '
      {apiVersion: "v1", kind: "Pod",
       metadata: {name: $n, namespace: $ns, labels: ($lb + {app: $n})},
       spec: ({restartPolicy: "Never", terminationGracePeriodSeconds: 1,
               containers: [{name: "c", image: $img, command: ["sh", "-c", $cmd]}
                 + (if $claim == "" then {} else {volumeMounts: [{name: "d", mountPath: "/data"}]} end)]}
              + (if $claim == "" then {} else {volumes: [{name: "d", persistentVolumeClaim: {claimName: $claim}}]} end)
              + $pl)}'
}

# pvc_json NAME NS CLASS SIZE [SNAPSHOT]
pvc_json() {
    jq -n --arg n "$1" --arg ns "$2" --arg sc "$3" --arg size "$4" --arg snap "${5:-}" \
        --argjson lb "$(labels)" '
      {apiVersion: "v1", kind: "PersistentVolumeClaim",
       metadata: {name: $n, namespace: $ns, labels: $lb},
       spec: ({accessModes: ["ReadWriteOnce"], volumeMode: "Filesystem",
               resources: {requests: {storage: $size}}}
              + (if $sc == "" then {} else {storageClassName: $sc} end)
              + (if $snap == "" then {} else
                   {dataSource: {name: $snap, kind: "VolumeSnapshot", apiGroup: "snapshot.storage.k8s.io"}} end))}'
}

TEST_NS=""
ensure_test_ns() {
    [[ -n $TEST_NS ]] && return 0
    TEST_NS="kmetal-validate-$RUN_ID"
    jq -n --arg n "$TEST_NS" --argjson lb "$(labels)" \
        '{apiVersion: "v1", kind: "Namespace", metadata: {name: $n, labels: $lb}}' | kapply ||
        { fail "cannot create namespace $TEST_NS"; TEST_NS=""; return 1; }
    register_cleanup "kubectl delete namespace $TEST_NS --wait=true --timeout=300s >/dev/null 2>&1"
}

# ===========================================================================
# undercluster
# ===========================================================================
declare -A FACT=()
ACTIVE_NODES=()
TUNNEL_TYPE=geneve

fact() { echo "${FACT[$1|$2]:-}"; }

read -r -d '' FACTS_SCRIPT <<'EOF'
exec 2>/dev/null
has() { command -v "$1" >/dev/null 2>&1 && echo 1 || echo 0; }
echo "uid=$(id -u)"
echo "hostname=$(hostname)"
echo "kernel=$(uname -r)"
echo "os=$(. /etc/os-release && echo "$PRETTY_NAME")"
echo "nproc=$(nproc)"
echo "mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
echo "root_bytes=$(df -B1 --output=size / | tail -n1 | tr -d ' ')"
echo "swap=$(swapon --noheadings --show=NAME | wc -l)"
echo "inotify=$(sysctl -n fs.inotify.max_user_instances)"
echo "ip_forward=$(sysctl -n net.ipv4.ip_forward)"
echo "br_netfilter=$([ -e /proc/sys/net/bridge/bridge-nf-call-iptables ] && echo 1 || echo 0)"
echo "conntrack=$(has conntrack)"
echo "socat=$(has socat)"
echo "curl=$(has curl)"
echo "ping=$(has ping)"
echo "netplan=$(has netplan)"
echo "ntp=$(timedatectl show -p NTPSynchronized --value)"
echo "kvm=$([ -c /dev/kvm ] && echo 1 || echo 0)"
echo "kvm_mod=$(grep -cE '^kvm_(intel|amd) ' /proc/modules)"
for m in geneve vxlan openvswitch; do
    if grep -q "^$m " /proc/modules || modprobe -n "$m"; then echo "mod_$m=1"; else echo "mod_$m=0"; fi
done
for d in /sys/class/net/*; do echo "speed_${d##*/}=$(cat "$d/speed")"; done
echo "links_b64=$(ip -d -j link show | base64 -w0)"
echo "addrs_b64=$(ip -j addr show | base64 -w0)"
command -v netplan >/dev/null && echo "netplan_b64=$(netplan get | base64 -w0)"
exit 0
EOF

uc_connectivity() {
    local n
    for n in "${NODE_LIST[@]}"; do printf '%s\n' "$FACTS_SCRIPT" >"$WORK/facts.$n.sh"; done
    run_on_nodes facts "${NODE_LIST[@]}"
    ACTIVE_NODES=()
    for n in "${NODE_LIST[@]}"; do
        local rc k v
        rc=$(cat "$WORK/facts.$n.rc" 2>/dev/null)
        if [[ $rc != 0 ]] || ! grep -q '^uid=0$' "$WORK/facts.$n.out"; then
            fail "$n ($(mgmt_ip "$n")): cannot run '$SSH_SUDO bash' over SSH as $SSH_USER"
            head -n 3 "$WORK/facts.$n.err" | detail
            continue
        fi
        while IFS='=' read -r k v; do FACT[$n|$k]=$v; done <"$WORK/facts.$n.out"
        ACTIVE_NODES+=("$n")
        pass "$n: SSH + sudo OK ($(fact "$n" os), kernel $(fact "$n" kernel))"
        [[ $(fact "$n" hostname) == "$n" ]] ||
            info "$n: hostname is '$(fact "$n" hostname)'"
    done
}

uc_topology() {
    local ncp nwk
    ncp=$(nodes_with_role cp | wc -l)
    nwk=$(nodes_with_role worker | wc -l)
    if ((ncp < 1 || nwk < 2)); then
        fail "$ncp control planes and $nwk workers: the minimum lab is 1 control plane and 2 workers"
    else
        pass "$ncp control planes and $nwk workers (minimum lab: 1 + 2)"
    fi
    ((ncp >= 3)) || warn "$ncp control planes: the documented minimum and production layout is 3"
    ((ncp % 2 == 1)) || warn "$ncp control planes: use an odd number for etcd quorum"

    ((HAVE_KUBE)) || { info "no working kubeconfig: node list and node labels not compared with the cluster"; return; }
    local kn n ip nodes_json lbx=node.kubernetes.io/exclude-from-external-load-balancers
    nodes_json=$(kubectl get nodes -o json)
    kn=$(jq -r '.items[] |
        "\(.metadata.name) \([.status.addresses[] | select(.type == "InternalIP") | .address] | first)"' <<<"$nodes_json")
    for n in $(jq -r --arg k "$lbx" '.items[] | select(.metadata.labels | has("node-role.kubernetes.io/control-plane") and has($k)) | .metadata.name' <<<"$nodes_json"); do
        fail "$n: $lbx is set on a control plane; MetalLB speakers must announce from it (kubectl label node $n $lbx-)"
    done
    for n in "${NODE_LIST[@]}"; do
        ip=$(awk -v n="$n" '$1 == n {print $2}' <<<"$kn")
        if [[ -z $ip ]]; then
            warn "$n is not a node of the cluster"
        elif [[ $ip != "$(mgmt_ip "$n")" ]]; then
            warn "$n: InternalIP is $ip, setup.env has mgmt $(mgmt_ip "$n")"
        else
            pass "$n: registered, InternalIP $ip"
        fi
    done
    while read -r n _; do
        [[ -n $n && -z ${NODE_ROLE[$n]:-} ]] && warn "cluster node $n is missing from setup.env"
    done <<<"$kn"
}

# physical parent of an interface, following VLAN links
link_parent() { # link_parent NODE IFACE
    local links name=$2 next i
    links=$(fact "$1" links_b64 | base64 -d)
    for i in 1 2 3 4; do
        next=$(jq -r --arg n "$name" '.[] | select(.ifname == $n) | .link // empty' <<<"$links")
        [[ -z $next ]] && break
        name=$next
    done
    echo "$name"
}

uc_hardware() {
    local n cpu mem_g root_g parent speed low
    for n in "${ACTIVE_NODES[@]}"; do
        cpu=$(fact "$n" nproc)
        mem_g=$(( $(fact "$n" mem_kb) / 1024 / 1024 ))
        root_g=$(( $(fact "$n" root_bytes) / 1000000000 ))
        parent=$(link_parent "$n" "${NET_IFACE[mgmt]}")
        speed=$(fact "$n" "speed_$parent")
        low=()
        ((cpu >= 8)) || low+=("$cpu CPU < 8")
        ((mem_g >= 15)) || low+=("${mem_g} GiB RAM < 16")
        ((root_g >= 95)) || low+=("${root_g} GB root filesystem < 100")
        if [[ $speed =~ ^[0-9]+$ ]] && ((speed > 0)); then
            ((speed >= 1000)) || low+=("$parent ${speed} Mb/s < 1 Gb/s")
        else
            info "$n: link speed of $parent unknown"
        fi
        if ((${#low[@]})); then
            warn "$n below the lab minimum: $(joinc "${low[@]}")"
        else
            pass "$n: ${cpu} CPU, ${mem_g} GiB RAM, ${root_g} GB root, $parent ${speed:-?} Mb/s"
            if ((cpu < 16 || mem_g < 60 || root_g < 475)) || [[ $speed =~ ^[0-9]+$ && $speed -lt 10000 ]]; then
                info "$n is below the production profile (16 CPU, 64 GB RAM, 500 GB NVMe, 10 Gb/s)"
            fi
        fi
    done
}

uc_os() {
    local n
    for n in "${ACTIVE_NODES[@]}"; do
        local bad=() soft=()
        [[ $(fact "$n" swap) == 0 ]] || bad+=("swap is on")
        [[ $(fact "$n" ip_forward) == 1 ]] || bad+=("net.ipv4.ip_forward=$(fact "$n" ip_forward)")
        [[ $(fact "$n" inotify) =~ ^[0-9]+$ && $(fact "$n" inotify) -ge 8192 ]] ||
            soft+=("fs.inotify.max_user_instances=$(fact "$n" inotify) (< 8192)")
        [[ $(fact "$n" br_netfilter) == 1 ]] || soft+=("br_netfilter not loaded")
        [[ $(fact "$n" conntrack) == 1 ]] || soft+=("conntrack missing")
        [[ $(fact "$n" socat) == 1 ]] || soft+=("socat missing")
        [[ $(fact "$n" ntp) == yes ]] || soft+=("clock not NTP-synchronised")
        [[ $(fact "$n" curl) == 1 ]] || soft+=("curl missing (internet checks skipped)")
        [[ $(fact "$n" ping) == 1 ]] || bad+=("ping missing (mesh checks impossible)")
        if [[ ${NODE_ROLE[$n]} == worker ]]; then
            [[ $(fact "$n" kvm) == 1 ]] || bad+=("/dev/kvm missing")
            [[ $(fact "$n" kvm_mod) -ge 1 ]] || bad+=("kvm_intel/kvm_amd not loaded")
        fi
        ((${#bad[@]})) && fail "$n: $(joinc "${bad[@]}")"
        ((${#soft[@]})) && warn "$n: $(joinc "${soft[@]}")"
        ((${#bad[@]} + ${#soft[@]} == 0)) && pass "$n: swap off, ip_forward, inotify, br_netfilter, NTP$([[ ${NODE_ROLE[$n]} == worker ]] && echo ', /dev/kvm')"
    done
}

is_central() { in_list "$1" "$CENTRAL_NODES"; }

uc_interfaces() {
    local n net iface exp links addrs l kind vid mtu flags have lenx ip
    for n in "${ACTIVE_NODES[@]}"; do
        links=$(fact "$n" links_b64 | base64 -d)
        addrs=$(fact "$n" addrs_b64 | base64 -d)
        for net in "${NETS[@]}"; do
            iface=${NET_IFACE[$net]}
            exp=${NODE_ADDR[$n|$net]}
            l=$(jq -c --arg i "$iface" '.[] | select(.ifname == $i)' <<<"$links")
            if [[ $exp == - ]]; then
                if in_list "$net" "$OPTIONAL_NETWORKS"; then
                    info "$n: optional network $net not configured"
                elif [[ $net == overlay && ${NODE_ROLE[$n]} == cp ]]; then
                    info "$n: control plane without overlay interface: expected, Kube-OVN's tunnel runs on the network nodes (kmetal.io/ovn) only$(is_central "$n" && echo "; ovn-central uses the node address")"
                else
                    fail "$n: no $net address declared; ${NODE_ROLE[$n]} nodes need the $net network"
                fi
                continue
            fi
            if [[ -z $l ]]; then
                if in_list "$net" "$OPTIONAL_NETWORKS"; then warn "$n: $net interface $iface not found"
                else fail "$n: $net interface $iface not found"; fi
                continue
            fi
            local problems=()
            flags=$(jq -r '.flags | join(",")' <<<"$l")
            [[ ,$flags, == *,LOWER_UP,* && ,$flags, == *,UP,* ]] || problems+=("not up ($flags)")
            vid=${NET_VLAN[$net]:-}
            if [[ -n $vid && $vid != 0 ]]; then
                kind=$(jq -r '.linkinfo.info_kind // "none"' <<<"$l")
                have=$(jq -r '.linkinfo.info_data.id // empty' <<<"$l")
                [[ $kind == vlan && $have == "$vid" ]] || problems+=("expected VLAN $vid, found ${kind}${have:+ id $have}")
            fi
            mtu=$(jq -r .mtu <<<"$l")
            [[ -z ${NET_MTU[$net]:-} || $mtu == "${NET_MTU[$net]}" ]] || problems+=("MTU $mtu, expected ${NET_MTU[$net]}")
            ip=$(addr_ip "$exp")
            lenx=$(addr_len "$exp" "$net")
            have=$(jq -r --arg i "$iface" '.[] | select(.ifname == $i) | .addr_info[]? |
                    select(.family == "inet") | "\(.local)/\(.prefixlen)"' <<<"$addrs" | paste -sd' ')
            [[ " $have " == *" $ip/$lenx "* ]] || problems+=("expected $ip/$lenx, has: ${have:-no IPv4}")
            if ((${#problems[@]})); then
                fail "$n: $net ($iface): $(joinc "${problems[@]}")"
            else
                pass "$n: $net $iface VLAN ${vid:-none} MTU $mtu $ip/$lenx (on $(jq -r '.link // "-"' <<<"$l"))"
                local extra=${have/"$ip/$lenx"/}
                [[ -n ${extra// /} ]] && info "$n: $iface also carries ${extra}"
            fi
        done
        for net in $PROVIDER_NETWORKS; do
            iface=${PROV_IFACE[$net]}
            l=$(jq -c --arg i "$iface" '.[] | select(.ifname == $i)' <<<"$links")
            if [[ ${NODE_ROLE[$n]} == cp ]]; then
                [[ -n $l ]] && info "$n: provider interface $iface present on a control plane (list it in excludeNodes unless intended)"
                continue
            fi
            if [[ -z $l ]]; then fail "$n: provider $net interface $iface not found"; continue; fi
            local problems=()
            flags=$(jq -r '.flags | join(",")' <<<"$l")
            [[ ,$flags, == *,LOWER_UP,* && ,$flags, == *,UP,* ]] || problems+=("not up ($flags)")
            vid=${PROV_VLAN[$net]:-}
            if [[ -n $vid && $vid != 0 ]]; then
                kind=$(jq -r '.linkinfo.info_kind // "none"' <<<"$l")
                have=$(jq -r '.linkinfo.info_data.id // empty' <<<"$l")
                [[ $kind == vlan && $have == "$vid" ]] || problems+=("expected VLAN $vid, found ${kind}${have:+ id $have}")
            fi
            have=$(jq -r --arg i "$iface" '.[] | select(.ifname == $i) | .addr_info[]? |
                    select(.family == "inet") | .local' <<<"$addrs" | paste -sd' ')
            [[ -z ${have// /} ]] || problems+=("carries IPv4 $have: a provider interface must have no address")
            if ((${#problems[@]})); then
                fail "$n: provider $net ($iface): $(joinc "${problems[@]}")"
            else
                pass "$n: provider $net $iface VLAN ${vid:-none} MTU $(jq -r .mtu <<<"$l"), no IPv4"
            fi
        done
    done
}

uc_netplan() {
    local n yaml iface missing prov_missing net km_ifaces=""
    # provider interfaces named in the KMetal resource, when it is reachable
    [[ -n $KM_JSON ]] && km_ifaces=$(km '.spec.networking.providerNetworks[]?.interface' | tr '\n' ' ')
    for n in "${ACTIVE_NODES[@]}"; do
        if [[ $(fact "$n" netplan) != 1 ]]; then
            info "$n: netplan not installed, persistence not checked"
            continue
        fi
        yaml=$(fact "$n" netplan_b64 | base64 -d)
        missing=() prov_missing=()
        for net in "${NETS[@]}"; do
            [[ ${NODE_ADDR[$n|$net]} == - ]] && continue
            iface=${NET_IFACE[$net]}
            grep -qE "^[[:space:]]+\"?${iface}\"?:" <<<"$yaml" || missing+=("$iface")
        done
        if [[ ${NODE_ROLE[$n]} == worker ]]; then
            for net in $PROVIDER_NETWORKS; do
                iface=${PROV_IFACE[$net]}
                grep -qE "^[[:space:]]+\"?${iface}\"?:" <<<"$yaml" || prov_missing+=("$iface")
            done
        fi
        ((${#missing[@]})) && warn "$n: node networks not declared in netplan, lost at reboot: ${missing[*]}"
        if ((${#prov_missing[@]})); then
            local managed=() other=() i
            for i in "${prov_missing[@]}"; do
                if in_list "$i" "$km_ifaces"; then managed+=("$i"); else other+=("$i"); fi
            done
            ((${#managed[@]})) &&
                info "$n: provider interfaces ${managed[*]} not in netplan: provider networks of the KMetal resource, created and managed by the platform"
            ((${#other[@]})) &&
                info "$n: provider interfaces ${other[*]} not in netplan: expected when kMetal is already installed and manages its provider networks; otherwise declare them in netplan"
        fi
        ((${#missing[@]} + ${#prov_missing[@]} == 0)) && pass "$n: every interface is declared in netplan"
    done
}

uc_addressing() {
    local i j a b r n role net
    for ((i = 0; i < ${#NETS[@]}; i++)); do
        for ((j = i + 1; j < ${#NETS[@]}; j++)); do
            a=${NETS[$i]} b=${NETS[$j]}
            if ranges_overlap "${NET_CIDR[$a]}" "${NET_CIDR[$b]}"; then
                fail "$a ${NET_CIDR[$a]} overlaps $b ${NET_CIDR[$b]}"
            fi
        done
    done
    pass "node networks do not overlap: $(for a in "${NETS[@]}"; do printf '%s=%s ' "$a" "${NET_CIDR[$a]}"; done)"

    [[ -n $KM_JSON ]] || { info "no KMetal resource reachable: pod/service/provider/LB ranges not cross-checked"; return; }
    local -A other=()
    other["kubeOVN.podCIDR"]=$(km .spec.networking.kubeOVN.podCIDR)
    other["serviceCIDR"]=$(km .spec.networking.serviceCIDR)
    other["Kube-OVN join"]=100.64.0.0/16
    while IFS=$'\t' read -r a b; do
        [[ -n $a ]] && other["provider subnet $a"]=$b
    done < <(km '.spec.networking.providerNetworks[]?.subnets[]? | [.name, .cidrBlock] | @tsv')
    for r in "${!other[@]}"; do
        [[ -n ${other[$r]} ]] || continue
        for net in "${NETS[@]}"; do
            ranges_overlap "${other[$r]}" "${NET_CIDR[$net]}" &&
                fail "$r ${other[$r]} overlaps node network $net ${NET_CIDR[$net]}"
        done
    done
    pass "checked against KMetal: $(for r in "${!other[@]}"; do [[ -n ${other[$r]} ]] && printf '%s=%s ' "${r// /_}" "${other[$r]}"; done)"

    # MetalLB ranges: inside their network, clear of node addresses
    for role in tenantControlPlanes:tenant management:mgmt; do
        net=${role#*:}
        while read -r r; do
            [[ -z $r ]] && continue
            if ! range_within "$r" "${NET_CIDR[$net]}"; then
                fail "loadBalancer.${role%:*} range $r is outside the $net network ${NET_CIDR[$net]}"
                continue
            fi
            local clash=()
            for n in "${NODE_LIST[@]}"; do
                [[ ${NODE_ADDR[$n|$net]} == - ]] && continue
                range_contains "$r" "$(addr_ip "${NODE_ADDR[$n|$net]}")" && clash+=("$n")
            done
            if ((${#clash[@]})); then
                fail "loadBalancer.${role%:*} range $r contains node addresses of: ${clash[*]}"
            else
                pass "loadBalancer.${role%:*} range $r is inside $net and clear of node addresses"
            fi
        done < <(km ".spec.networking.loadBalancer.${role%:*}.addresses[]?")
    done
}

uc_mesh() {
    local n p net iface tag=mesh
    for n in "${ACTIVE_NODES[@]}"; do
        {
            cat <<'EOF'
p() { local out loss; out=$(ping -c3 -i0.2 -W1 -q -I "$2" "$3" 2>&1)
      loss=$(sed -nE 's/.* ([0-9.]+)% packet loss.*/\1/p' <<<"$out"); echo "mesh $1 $3 ${loss:-100}"; }
j() { if ping -c2 -i0.2 -W1 -q -M do -s "$4" -I "$2" "$3" >/dev/null 2>&1; then echo "jumbo $1 $3 ok"; else echo "jumbo $1 $3 fail"; fi; }
EOF
            for net in "${NETS[@]}"; do
                [[ ${NODE_ADDR[$n|$net]} == - ]] && continue
                iface=${NET_IFACE[$net]}
                for p in "${ACTIVE_NODES[@]}"; do
                    [[ $p == "$n" || ${NODE_ADDR[$p|$net]} == - ]] && continue
                    echo "p $net $iface $(addr_ip "${NODE_ADDR[$p|$net]}")"
                    if [[ -n ${NET_MTU[$net]:-} && ${NET_MTU[$net]} -gt 1500 ]]; then
                        echo "j $net $iface $(addr_ip "${NODE_ADDR[$p|$net]}") $(( ${NET_MTU[$net]} - 28 ))"
                    fi
                done
            done
        } >"$WORK/$tag.$n.sh"
    done
    run_on_nodes "$tag" "${ACTIVE_NODES[@]}"
    local kind loss peer ok_count
    for n in "${ACTIVE_NODES[@]}"; do
        ok_count=0
        while read -r kind net peer loss; do
            case $kind in
                mesh)
                    if [[ $loss == 0 ]]; then ok_count=$((ok_count + 1))
                    elif [[ $loss == 100 ]]; then fail "$n -> $peer on $net (${NET_IFACE[$net]}): unreachable"
                    else warn "$n -> $peer on $net: ${loss}% packet loss"; fi ;;
                jumbo)
                    [[ $loss == ok ]] || warn "$n -> $peer on $net: MTU ${NET_MTU[$net]} does not pass end to end (ping -M do -s $(( ${NET_MTU[$net]} - 28 )))" ;;
            esac
        done <"$WORK/$tag.$n.out"
        ((ok_count > 0)) && pass "$n: $ok_count peer addresses reachable without loss"
    done
}

uc_internet() {
    local n net tag=inet
    for n in "${ACTIVE_NODES[@]}"; do
        {
            printf 'URL=%q IP=%q DNS=%q\n' "$INTERNET_PROBE_URL" "$INTERNET_PROBE_IP" "$DNS_PROBE"
            cat <<'EOF'
c() { if command -v curl >/dev/null && curl -sS -o /dev/null --max-time 6 --interface "$2" "$URL" 2>/dev/null; then echo "curl $1 ok"; else echo "curl $1 fail"; fi
      if ping -c2 -W2 -q -I "$2" "$IP" >/dev/null 2>&1; then echo "icmp $1 ok"; else echo "icmp $1 fail"; fi; }
if getent hosts "$DNS" >/dev/null; then echo "dns - ok"; else echo "dns - fail"; fi
EOF
            for net in "${NETS[@]}"; do
                [[ ${NODE_ADDR[$n|$net]} == - ]] && continue
                echo "c $net ${NET_IFACE[$net]}"
            done
        } >"$WORK/$tag.$n.sh"
    done
    run_on_nodes "$tag" "${ACTIVE_NODES[@]}"
    local kind res leaks=0
    for n in "${ACTIVE_NODES[@]}"; do
        local -A R=()
        while read -r kind net res; do R[$kind|$net]=$res; done <"$WORK/$tag.$n.out"
        [[ ${R[dns|-]} == ok ]] && pass "$n: resolves $DNS_PROBE" || fail "$n: cannot resolve $DNS_PROBE"
        for net in "${NETS[@]}"; do
            [[ ${NODE_ADDR[$n|$net]} == - ]] && continue
            if [[ $net == "$NET_INTERNET" ]]; then
                if [[ ${R[curl|$net]} == ok ]]; then
                    pass "$n: reaches $INTERNET_PROBE_URL through $net"
                else
                    fail "$n: cannot reach $INTERNET_PROBE_URL through $net (${NET_IFACE[$net]})"
                fi
                [[ ${R[icmp|$net]} == ok ]] || info "$n: no ICMP reply from $INTERNET_PROBE_IP through $net (may be filtered)"
            elif [[ ${R[curl|$net]} == ok || ${R[icmp|$net]} == ok ]]; then
                warn "$n: $net (${NET_IFACE[$net]}) reaches the internet; only $NET_INTERNET should"
                leaks=$((leaks + 1))
            fi
        done
        unset R
    done
    ((leaks)) || pass "no network other than $NET_INTERNET reaches the internet"
}

uc_encap() {
    local n m ok_mods
    for n in "${ACTIVE_NODES[@]}"; do
        local missing=()
        for m in geneve vxlan openvswitch; do
            [[ $(fact "$n" "mod_$m") == 1 ]] || missing+=("$m")
        done
        if ((${#missing[@]} == 0)); then
            pass "$n: kernel modules geneve, vxlan, openvswitch available"
        elif [[ ${NODE_ADDR[$n|overlay]} == - ]]; then
            info "$n: modules not available: ${missing[*]} (no overlay on this node)"
        elif in_list "$TUNNEL_TYPE" "${missing[*]}" || in_list openvswitch "${missing[*]}"; then
            fail "$n: kernel modules not available: ${missing[*]}"
        else
            warn "$n: kernel modules not available: ${missing[*]}"
        fi
    done

    local cand=()
    for n in "${ACTIVE_NODES[@]}"; do
        [[ ${NODE_ADDR[$n|overlay]} != - ]] && cand+=("$n")
    done
    if ((${#cand[@]} < 2)); then
        info "fewer than two nodes with an overlay address: tunnel test skipped"
        return
    fi
    local a=${cand[0]} b=${cand[1]} ipa ipb dev=kvtest0 port=$ENCAP_TEST_PORT
    ipa=$(addr_ip "${NODE_ADDR[$a|overlay]}")
    ipb=$(addr_ip "${NODE_ADDR[$b|overlay]}")
    [[ $TUNNEL_TYPE == vxlan ]] && port=$((ENCAP_TEST_PORT + 1))
    local mk="ip link del $dev 2>/dev/null; ip link add $dev type $TUNNEL_TYPE id 4242 remote"
    local extra="dstport $port"
    [[ $TUNNEL_TYPE == vxlan ]] && extra="dstport $port dev ${NET_IFACE[overlay]}"
    register_cleanup "node_exec $a <<<'ip link del $dev 2>/dev/null; true'; node_exec $b <<<'ip link del $dev 2>/dev/null; true'"
    if ! node_exec "$a" <<<"$mk $ipb $extra && ip addr add 169.254.250.1/30 dev $dev && ip link set $dev up" >/dev/null 2>"$WORK/encap.err" ||
       ! node_exec "$b" <<<"$mk $ipa $extra && ip addr add 169.254.250.2/30 dev $dev && ip link set $dev up" >/dev/null 2>>"$WORK/encap.err"; then
        fail "cannot create a $TUNNEL_TYPE test device between $a and $b"
        detail <"$WORK/encap.err"
    elif node_exec "$a" <<<"ping -c3 -i0.2 -W1 -q 169.254.250.2" >/dev/null 2>&1; then
        pass "$TUNNEL_TYPE tunnel $a ($ipa) <-> $b ($ipb) on UDP $port carries traffic"
    else
        fail "$TUNNEL_TYPE tunnel $a ($ipa) <-> $b ($ipb) on UDP $port: no traffic (firewall or overlay routing)"
    fi
    node_exec "$a" <<<"ip link del $dev" >/dev/null 2>&1
    node_exec "$b" <<<"ip link del $dev" >/dev/null 2>&1
}

cmd_undercluster() {
    require ssh jq base64 awk
    ((HAVE_ENV)) || die "undercluster needs setup.env (-e FILE)"
    if command -v kubectl >/dev/null && kube_ok; then
        HAVE_KUBE=1
        if load_km; then
            [[ -z $CENTRAL_NODES ]] && CENTRAL_NODES=$(km '.spec.networking.kubeOVN.centralNodes[]?' | tr '\n' ' ')
            TUNNEL_TYPE=$(km .spec.networking.kubeOVN.tunnelType); TUNNEL_TYPE=${TUNNEL_TYPE:-geneve}
        fi
    fi
    print_env
    [[ -n $CENTRAL_NODES ]] && info "Kube-OVN central nodes: $CENTRAL_NODES"
    section "connectivity"
    uc_connectivity
    ((${#ACTIVE_NODES[@]})) || return
    run_group topology   uc_topology
    run_group hardware   uc_hardware
    run_group os         uc_os
    run_group interfaces uc_interfaces
    run_group netplan    uc_netplan
    run_group addressing uc_addressing
    run_group mesh       uc_mesh
    run_group internet   uc_internet
    run_group encap      uc_encap
}

# ===========================================================================
# kmetal
