pods_not_ok_jq='def ok: (.status.phase == "Succeeded")
                   or (.status.phase == "Running" and ([.status.containerStatuses[]?.ready] | all));'

km_platform() {
    load_km || { fail "no KMetal resource (kubectl get km)"; return; }
    local ready version total bad
    ready=$(table_col READY km "$KM_NAME")
    version=$(table_col VERSION km "$KM_NAME")
    if [[ $ready == True ]]; then pass "KMetal $KM_NAME READY=True, version ${version:-unknown}"
    else fail "KMetal $KM_NAME READY=${ready:-unknown}"; fi
    total=$(km '.status.components | length')
    if [[ -z $total || $total == 0 ]]; then
        warn "KMetal reports no .status.components"
        return
    fi
    bad=$(km '.status.components[] | select(.phase != "Ready") | "\(.name)\t\(.phase)\t\(.message // "")"')
    if [[ -z $bad ]]; then
        pass "all $total components Ready"
    else
        local name phase msg
        while IFS=$'\t' read -r name phase msg; do
            fail "component $name is $phase${msg:+: $msg}"
        done <<<"$bad"
    fi
}

check_operator_version() { # check_operator_version VERSION
    local ver=${1#v}
    if [[ -z $ver ]]; then
        warn "operator chart version unknown; this script validates kMetal $TARGET_KMETAL.x"
    elif [[ $ver == "$TARGET_KMETAL" || $ver == "$TARGET_KMETAL".* ]]; then
        pass "operator chart $ver matches the validated kMetal $TARGET_KMETAL.x"
    else
        warn "operator chart is $ver; this script validates kMetal $TARGET_KMETAL.x"
    fi
}

km_operator() {
    local rel status chart ver op_ns=$KMETAL_NAMESPACE
    rel=$(helm list -n "$KMETAL_NAMESPACE" -a -o json 2>/dev/null | jq -c --arg r "$KMETAL_RELEASE" '.[] | select(.name == $r)')
    if [[ -n $rel ]]; then
        status=$(jq -r .status <<<"$rel")
        chart=$(jq -r .chart <<<"$rel")
        ver=${chart#"$KMETAL_RELEASE"-}
        [[ $status == deployed ]] && pass "helm release $KMETAL_RELEASE is deployed ($chart)" ||
            fail "helm release $KMETAL_RELEASE is $status ($chart)"
        check_operator_version "$ver"
    else
        # Not installed with helm in $KMETAL_NAMESPACE: look for a Flux HelmRelease (GitOps install).
        local hr name ready
        hr=$(kubectl get helmreleases.helm.toolkit.fluxcd.io -n "$NS_FLUX" -o json 2>/dev/null |
             jq -c --arg r "$KMETAL_RELEASE" '[.items[] | select(.metadata.name == $r
                     or .spec.releaseName == $r or .spec.chart.spec.chart == $r)][0] // empty')
        if [[ -z $hr ]]; then
            fail "operator not found: no helm release $KMETAL_RELEASE in $KMETAL_NAMESPACE, no HelmRelease $KMETAL_RELEASE in $NS_FLUX"
        else
            name=$(jq -r .metadata.name <<<"$hr")
            ready=$(jq -r '[.status.conditions[]? | select(.type == "Ready") | .status] | first // "Unknown"' <<<"$hr")
            ver=$(jq -r '.status.history[0].chartVersion // .status.lastAttemptedRevision // .spec.chart.spec.version // empty' <<<"$hr")
            op_ns=$(jq -r '.spec.targetNamespace // .metadata.namespace' <<<"$hr")
            pass "operator installed by Flux: HelmRelease $NS_FLUX/$name (Ready=$ready, target namespace $op_ns)"
            check_operator_version "$ver"
        fi
    fi

    local bad
    bad=$(kubectl get pods -n "$op_ns" -o json | jq -r "$pods_not_ok_jq"'.items[] | select(ok | not) | "\(.metadata.name) \(.status.phase)"')
    if [[ -z $bad ]]; then pass "operator pods Running in $op_ns"
    else fail "operator pods not ready: $(tr '\n' ' ' <<<"$bad")"; fi

    local kind j n_all n_bad
    for kind in helmreleases.helm.toolkit.fluxcd.io kustomizations.kustomize.toolkit.fluxcd.io ocirepositories.source.toolkit.fluxcd.io; do
        j=$(kubectl get "$kind" -n "$NS_FLUX" -o json 2>/dev/null) || { info "$kind not served"; continue; }
        n_all=$(jq '.items | length' <<<"$j")
        bad=$(jq -r '.items[] | select(([.status.conditions[]? | select(.type == "Ready") | .status] | first) != "True")
              | "\(.metadata.name): \([.status.conditions[]? | select(.type == "Ready") | .message] | first // "no Ready condition")"' <<<"$j")
        n_bad=$(grep -c . <<<"$bad")
        if [[ -z $bad ]]; then pass "$n_all ${kind%%.*} Ready in $NS_FLUX"
        else
            fail "$n_bad of $n_all ${kind%%.*} not Ready in $NS_FLUX"
            head -n 10 <<<"$bad" | detail
        fi
    done

    bad=$(kubectl get pods -A -o json | jq -r --arg p "kmetal-validate-" --arg r "kv-$RUN_ID" "$pods_not_ok_jq"'
          .items[] | select(.metadata.namespace | startswith($p) or startswith($r) | not) | select(ok | not)
          | "\(.metadata.namespace)/\(.metadata.name) \(.status.phase)"')
    if [[ -z $bad ]]; then pass "no pod outside Running/Completed in the cluster"
    else
        warn "$(grep -c . <<<"$bad") pods outside Running/Completed"
        head -n 15 <<<"$bad" | detail
    fi
}

declare -A POOL_FOR=()

km_metallb() {
    local pools l2 role r p a found
    pools=$(kubectl get ipaddresspools.metallb.io -n "$NS_METALLB" -o json 2>/dev/null) ||
        { fail "no IPAddressPool API in $NS_METALLB"; return; }
    for role in tenantControlPlanes management; do
        while read -r r; do
            [[ -z $r ]] && continue
            found=""
            while read -r p a; do
                [[ -z $p ]] && continue
                if [[ $(range_lohi "$a") == "$(range_lohi "$r")" ]]; then found=$p; break; fi
            done < <(jq -r '.items[] | .metadata.name as $n | .spec.addresses[] | "\($n) \(.)"' <<<"$pools")
            if [[ -n $found ]]; then
                pass "loadBalancer.$role $r is served by IPAddressPool $found"
                POOL_FOR[$role]=${POOL_FOR[$role]:-$found}
            else
                fail "loadBalancer.$role $r is not in any IPAddressPool of $NS_METALLB"
            fi
        done < <(km ".spec.networking.loadBalancer.$role.addresses[]?")
        [[ -n $(km ".spec.networking.loadBalancer.$role.addresses[0]?") ]] ||
            fail "spec.networking.loadBalancer.$role.addresses is empty"
    done

    l2=$(kubectl get l2advertisements.metallb.io -n "$NS_METALLB" -o json 2>/dev/null)
    if [[ -z $l2 || $(jq '.items | length' <<<"$l2") == 0 ]]; then
        fail "no L2Advertisement in $NS_METALLB"
    else
        for role in "${!POOL_FOR[@]}"; do
            p=${POOL_FOR[$role]}
            if jq -e --arg p "$p" 'any(.items[]; (.spec.ipAddressPools // []) as $l | ($l | length == 0 and (.spec.ipAddressPoolSelectors // [] | length == 0)) or ($l | index($p)) or (.spec.ipAddressPoolSelectors // [] | length > 0))' <<<"$l2" >/dev/null; then
                pass "pool $p is advertised by an L2Advertisement"
            else
                fail "pool $p is not referenced by any L2Advertisement"
            fi
        done
    fi

    local speakers cps n
    speakers=$(kubectl get pods -n "$NS_METALLB" -l app.kubernetes.io/component=speaker -o json 2>/dev/null |
               jq -r "$pods_not_ok_jq"'.items[] | select(ok) | .spec.nodeName')
    cps=$(kubectl get nodes -l node-role.kubernetes.io/control-plane -o jsonpath='{.items[*].metadata.name}' 2>/dev/null)
    if [[ -z $speakers ]]; then
        info "no MetalLB speaker pods found with app.kubernetes.io/component=speaker in $NS_METALLB"
    else
        for n in $cps; do
            grep -qx "$n" <<<"$speakers" && pass "$n: MetalLB speaker Ready" ||
                warn "$n: no Ready MetalLB speaker on this control plane"
        done
    fi

    ((${#POOL_FOR[@]})) || return
    ensure_test_ns || return
    jq -n --arg ns "$TEST_NS" --arg img "$TEST_IMAGE" --argjson lb "$(labels)" '
      {apiVersion: "apps/v1", kind: "Deployment",
       metadata: {name: "lb-backend", namespace: $ns, labels: $lb},
       spec: {replicas: 1, selector: {matchLabels: {app: "lb-backend"}},
              template: {metadata: {labels: {app: "lb-backend"}},
                         spec: {containers: [{name: "web", image: $img, ports: [{containerPort: 80}]}]}}}}' | kapply
    kubectl rollout status deploy/lb-backend -n "$TEST_NS" --timeout=180s >/dev/null 2>&1 ||
        warn "LB backend $TEST_IMAGE not ready; allocation is still tested"
    for role in "${!POOL_FOR[@]}"; do
        p=${POOL_FOR[$role]}
        local svc="lb-${role,,}" ip
        jq -n --arg ns "$TEST_NS" --arg n "$svc" --arg p "$p" --argjson lb "$(labels)" '
          {apiVersion: "v1", kind: "Service",
           metadata: {name: $n, namespace: $ns, labels: $lb, annotations: {"metallb.io/address-pool": $p}},
           spec: {type: "LoadBalancer", selector: {app: "lb-backend"}, ports: [{port: 80, targetPort: 80}]}}' | kapply
        ip=""
        lb_ip() { ip=$(kubectl get svc "$svc" -n "$TEST_NS" -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null); [[ -n $ip ]]; }
        if ! poll 120 3 lb_ip; then
            fail "Service from pool $p got no EXTERNAL-IP in 120s"
            kubectl describe svc "$svc" -n "$TEST_NS" | sed -n '/^Events:/,$p' | detail
            continue
        fi
        local in=0
        while read -r r; do [[ -n $r ]] && range_contains "$r" "$ip" && in=1; done < <(km ".spec.networking.loadBalancer.$role.addresses[]?")
        ((in)) && pass "pool $p allocated $ip, inside loadBalancer.$role" ||
            fail "pool $p allocated $ip, outside loadBalancer.$role"
        if curl -s -o /dev/null -m 5 "http://$ip/"; then
            pass "http://$ip/ answers from this machine"
        elif ((HAVE_ENV)) && node_cmd "$(first_node cp)" "curl -s -o /dev/null -m 5 http://$ip/" 2>/dev/null; then
            pass "http://$ip/ answers from $(first_node cp)"
        else
            warn "http://$ip/ does not answer from this machine$( ((HAVE_ENV)) && echo " nor from $(first_node cp)")"
        fi
    done
}

km_storage() {
    local uc tc ec vsc j prov
    uc=$(km .spec.storage.underclusterClassName)
    tc=$(km .spec.storage.tenantClassName)
    ec=$(km .spec.storage.etcdClassName)
    [[ -n $uc ]] || fail "spec.storage.underclusterClassName is not set"
    [[ -n $tc ]] || fail "spec.storage.tenantClassName is not set"
    [[ -n $uc && -n $tc && $uc == "$tc" ]] &&
        warn "underclusterClassName and tenantClassName are both $uc: tenant storage quota counts by class name, use two names"
    local -A role_of=()
    [[ -n $uc ]] && role_of[uc]=$uc
    [[ -n $tc ]] && role_of[tenant]=$tc
    [[ -n $ec ]] && role_of[etcd]=$ec || info "etcdClassName not set: Kamaji etcd uses $uc"
    local r c
    for r in uc tenant etcd; do
        c=${role_of[$r]:-}
        [[ -z $c ]] && continue
        j=$(kubectl get storageclass "$c" -o json 2>/dev/null) || { fail "StorageClass $c ($r) does not exist"; unset "role_of[$r]"; continue; }
        pass "StorageClass $c ($r): $(jq -r '"\(.provisioner), \(.volumeBindingMode), expansion \(.allowVolumeExpansion // false)"' <<<"$j")"
        if [[ $r != etcd && $(jq -r '.allowVolumeExpansion // false' <<<"$j") != true ]]; then
            warn "StorageClass $c does not allow volume expansion"
        fi
    done

    if [[ -n ${role_of[uc]:-} ]]; then
        prov=$(kubectl get storageclass "$uc" -o jsonpath='{.provisioner}')
        vsc=$(km .spec.clusterClass.values.dataVolume.volumeSnapshotClass)
        if [[ -n $vsc ]]; then
            j=$(kubectl get volumesnapshotclass "$vsc" -o json 2>/dev/null)
            if [[ -z $j ]]; then fail "VolumeSnapshotClass $vsc (clusterClass.values.dataVolume) does not exist"; vsc=""
            elif [[ $(jq -r .driver <<<"$j") != "$prov" ]]; then
                fail "VolumeSnapshotClass $vsc uses driver $(jq -r .driver <<<"$j"), $uc uses $prov"
            else pass "VolumeSnapshotClass $vsc on driver $prov"; fi
        else
            vsc=$(kubectl get volumesnapshotclass -o json 2>/dev/null | jq -r --arg d "$prov" '[.items[] | select(.driver == $d)] |
                  (map(select(.metadata.annotations["snapshot.storage.kubernetes.io/is-default-class"] == "true")) + .)[0].metadata.name // empty')
            if [[ -n $vsc ]]; then pass "VolumeSnapshotClass $vsc on driver $prov (clusterClass.values.dataVolume.volumeSnapshotClass not set)"
            else fail "no VolumeSnapshotClass for driver $prov: golden images cannot be snapshotted, no tenant machine boots"; fi
        fi
        local sp clone snapc
        sp=$(kubectl get storageprofile "$uc" -o json 2>/dev/null)
        clone=$(jq -r '.status.cloneStrategy // empty' <<<"$sp")
        snapc=$(jq -r '.status.snapshotClass // empty' <<<"$sp")
        if [[ -z $sp ]]; then warn "no CDI StorageProfile $uc"
        elif [[ -z $snapc ]]; then fail "StorageProfile $uc has no snapshotClass: tenant machines will not boot"
        else pass "StorageProfile $uc: cloneStrategy ${clone:-default}, snapshotClass $snapc"; fi
        STORAGE_CLONE=$clone
    fi

    ensure_test_ns || return
    local pl
    for r in uc tenant etcd; do
        c=${role_of[$r]:-}
        [[ -z $c ]] && continue
        if [[ $r == etcd ]]; then
            pl=$(km '{nodeSelector: (.spec.placement.nodeSelector // {"node-role.kubernetes.io/control-plane": ""}),
                      tolerations: (.spec.placement.tolerations // [{key: "node-role.kubernetes.io/control-plane", operator: "Exists", effect: "NoSchedule"}])}' | jq -c .)
        else
            pl=$PLACEMENT_COMPUTE
        fi
        pvc_json "pvc-$r" "$TEST_NS" "$c" 1Gi | kapply
        pod_json "w-$r" "$TEST_NS" "$PROBE_IMAGE" "$pl" "pvc-$r" \
            'echo kmetal-validate > /data/probe && sync && cat /data/probe' | kapply
        if wait_pod_done "$TEST_NS" "w-$r" 300; then
            pass "$c: PVC Bound, write/read OK on $(kubectl get pod "w-$r" -n "$TEST_NS" -o jsonpath='{.spec.nodeName}')"
        else
            fail "$c: PVC/pod smoke test did not complete in 300s"
            pod_diag "$TEST_NS" "w-$r" "pvc-$r"
            [[ $r == uc ]] && vsc=""
        fi
    done

    [[ -n ${role_of[uc]:-} && -n $vsc ]] || return
    jq -n --arg ns "$TEST_NS" --arg c "$vsc" --argjson lb "$(labels)" '
      {apiVersion: "snapshot.storage.k8s.io/v1", kind: "VolumeSnapshot",
       metadata: {name: "snap-uc", namespace: $ns, labels: $lb},
       spec: {volumeSnapshotClassName: $c, source: {persistentVolumeClaimName: "pvc-uc"}}}' | kapply
    snap_ready() { [[ $(kubectl get volumesnapshot snap-uc -n "$TEST_NS" -o jsonpath='{.status.readyToUse}' 2>/dev/null) == true ]]; }
    if ! poll 300 3 snap_ready; then
        fail "VolumeSnapshot of a $uc volume not readyToUse in 300s"
        kubectl describe volumesnapshot snap-uc -n "$TEST_NS" | sed -n '/^Events:/,$p' | detail
        return
    fi
    pass "VolumeSnapshot of a $uc volume readyToUse (class $vsc)"
    pvc_json pvc-restore "$TEST_NS" "$uc" 1Gi snap-uc | kapply
    pod_json r-uc "$TEST_NS" "$PROBE_IMAGE" "$PLACEMENT_COMPUTE" pvc-restore \
        'grep -q kmetal-validate /data/probe && echo w > /data/written && sync && cat /data/written' | kapply
    if wait_pod_done "$TEST_NS" r-uc 300; then
        pass "volume restored from the snapshot holds the data and is writable"
    else
        local msg="volume restored from a $uc snapshot is not usable (read or write failed)"
        if [[ ${STORAGE_CLONE:-} == snapshot ]]; then
            fail "$msg; StorageProfile cloneStrategy is snapshot, so tenant root disks would fail"
        else
            warn "$msg; tenant root disks are cloned with cloneStrategy ${STORAGE_CLONE:-default}"
        fi
        pod_diag "$TEST_NS" r-uc pvc-restore
    fi
}

km_nodes() {
    local nodes compute network central n
    nodes=$(kubectl get nodes -o json)
    has_label() { jq -e --arg n "$1" --arg k "$2" '.items[] | select(.metadata.name == $n) | .metadata.labels | has($k)' <<<"$nodes" >/dev/null; }
    label_val() { jq -r --arg n "$1" --arg k "$2" '.items[] | select(.metadata.name == $n) | .metadata.labels[$k] // empty' <<<"$nodes"; }

    compute=$(jq -r '.items[] | select(.metadata.labels | has("node-role.kubernetes.io/compute")) | .metadata.name' <<<"$nodes")
    if [[ -z $compute ]]; then
        fail "no node labelled node-role.kubernetes.io/compute: no tenant machine or image-builder VM can start"
    else
        pass "compute nodes: $(tr '\n' ' ' <<<"$compute")"
        local vh
        vh=$(kubectl get pods -n "$NS_KUBEVIRT" -l kubevirt.io=virt-handler -o json 2>/dev/null |
             jq -r "$pods_not_ok_jq"'.items[] | select(ok) | .spec.nodeName')
        for n in $compute; do
            grep -qx "$n" <<<"$vh" && pass "$n: virt-handler Ready" || fail "$n: no Ready virt-handler pod"
        done
    fi

    local cps
    cps=$(jq -r '.items[] | select(.metadata.labels | has("node-role.kubernetes.io/control-plane")) | .metadata.name' <<<"$nodes")

    # MetalLB speakers announce from the control planes: kubeadm's exclusion label must be gone
    local lbx=node.kubernetes.io/exclude-from-external-load-balancers
    for n in $cps; do
        if has_label "$n" "$lbx"; then
            fail "$n: $lbx is set; MetalLB does not announce from this control plane (kubectl label node $n $lbx-)"
        else
            pass "$n: no $lbx label, MetalLB can announce from it"
        fi
    done

    # network nodes: kmetal.io/ovn, where Kube-OVN's per-node components run (never the control planes)
    network=$(jq -r '.items[] | select(.metadata.labels | has("kmetal.io/ovn")) | .metadata.name' <<<"$nodes")
    local cni
    cni=$(kubectl get pods -A -l app=kube-ovn-cni -o json 2>/dev/null | jq -r "$pods_not_ok_jq"'.items[] | select(ok) | .spec.nodeName')
    if [[ -z $network ]]; then
        fail "no node labelled kmetal.io/ovn: Kube-OVN's per-node DaemonSets run nowhere"
    else
        pass "network nodes (kmetal.io/ovn): $(tr '\n' ' ' <<<"$network")"
        local tif
        tif=$(km .spec.networking.kubeOVN.tunnelInterface)
        for n in $network; do
            if in_list "$n" "$cps"; then
                warn "$n: control plane labelled kmetal.io/ovn; the label belongs on network nodes only (kubectl label node $n kmetal.io/ovn-)"
            fi
            [[ $(label_val "$n" ovn.kubernetes.io/external-gw) == true ]] &&
                pass "$n: ovn.kubernetes.io/external-gw=true" ||
                fail "$n: ovn.kubernetes.io/external-gw=true missing (operator 1.0.0 does not set it)"
            grep -qx "$n" <<<"$cni" && pass "$n: kube-ovn-cni Ready" || fail "$n: no Ready kube-ovn-cni pod"
            if ((HAVE_ENV)) && [[ -n ${NODE_ROLE[$n]:-} && -n $tif ]]; then
                node_cmd "$n" "ip link show dev $tif >/dev/null 2>&1" 2>/dev/null &&
                    pass "$n: tunnelInterface $tif present" ||
                    fail "$n: tunnelInterface $tif missing on a network node"
            fi
        done
    fi
    jq -e 'any(.items[]; .metadata.labels | has("node-role.kubernetes.io/network"))' <<<"$nodes" >/dev/null &&
        info "node-role.kubernetes.io/network is set on some nodes; kMetal 1.0.0 places Kube-OVN by kmetal.io/ovn"

    # central nodes: the OVSDB Raft members, the control planes when there are three
    central=$(km '.spec.networking.kubeOVN.centralNodes[]?')
    local nc ncp ncp_central=0 unused=()
    nc=$(grep -c . <<<"$central")
    ncp=$(grep -c . <<<"$cps")
    if [[ -z $central ]]; then
        fail "spec.networking.kubeOVN.centralNodes is empty"
    else
        for n in $central; do
            if ! jq -e --arg n "$n" 'any(.items[]; .metadata.name == $n)' <<<"$nodes" >/dev/null; then
                fail "central node $n is not a node of the cluster"; continue
            fi
            [[ $(label_val "$n" kube-ovn/role) == master ]] &&
                pass "$n: kube-ovn/role=master (central node)" ||
                fail "$n: kube-ovn/role=master missing on a central node (operator 1.0.0 does not set it)"
            if in_list "$n" "$cps"; then
                ncp_central=$((ncp_central + 1))
            else
                warn "$n: worker listed in centralNodes; ovn-central belongs on the control planes"
            fi
        done
        for n in $cps; do in_list "$n" "$central" || unused+=("$n"); done
        if ((ncp >= 3 && ncp_central < 3)); then
            warn "centralNodes lists $ncp_central control plane(s); list three control planes (available: ${unused[*]})"
        fi
        if ((nc < 3 || nc % 2 == 0)); then
            warn "$nc central node(s): fill centralNodes to three nodes (control planes, or workers when fewer control planes exist) for OVSDB Raft consensus"
        else
            pass "$nc central nodes ($ncp_central of them control planes): Raft keeps quorum through the loss of $(( (nc - 1) / 2 ))"
        fi
    fi
    for n in $(jq -r '.items[] | select(.metadata.labels["kube-ovn/role"] == "master") | .metadata.name' <<<"$nodes"); do
        in_list "$n" "$central" || warn "$n carries kube-ovn/role=master but is not in centralNodes"
    done
}

# Provider networks of the KMetal resource. Those whose interface is in setup.env's
# PROVIDER_NETWORKS are the defaults already checked by `undercluster`; the others are
# additional networks managed by the platform and are validated here.
km_providers() {
    local nodes network spec n
    nodes=$(kubectl get nodes -o json)
    network=$(jq -r '.items[] | select(.metadata.labels | has("kmetal.io/ovn")) | .metadata.name' <<<"$nodes")
    spec=$(kmj '[.spec.networking.providerNetworks[]?]')
    if [[ -z $spec || $(jq length <<<"$spec") == 0 ]]; then
        warn "no providerNetworks in the KMetal resource: tenants get no external access"
        return
    fi

    local env_ifaces="" p
    for p in $PROVIDER_NETWORKS; do env_ifaces+="${PROV_IFACE[$p]} "; done

    # every subnet, for overlap checks
    local all_subnets
    all_subnets=$(jq -r '.[] | .name as $p | .subnets[]? | "\($p)/\(.name) \(.cidrBlock)"' <<<"$spec")

    local dflt
    dflt=$(km .spec.networking.defaultProviderSubnet)
    if [[ -z $dflt ]]; then
        info "defaultProviderSubnet not set"
    elif jq -e --arg d "$dflt" 'any(.[].subnets[]?; .name == $d)' <<<"$spec" >/dev/null; then
        pass "defaultProviderSubnet $dflt exists"
    else
        fail "defaultProviderSubnet $dflt is not a subnet of any provider network"
    fi

    local pn iface excl origin net
    while IFS=$'\t' read -r pn iface excl; do
        [[ -z $pn ]] && continue
        if ((HAVE_ENV)) && in_list "$iface" "$env_ifaces"; then
            origin=default
            info "provider network $pn ($iface): declared in setup.env, also checked by undercluster"
        else
            origin=additional
            info "provider network $pn ($iface): additional, not in setup.env; validated here"
        fi
        for n in $excl; do
            jq -e --arg n "$n" 'any(.items[]; .metadata.name == $n)' <<<"$nodes" >/dev/null ||
                warn "provider network $pn: excludeNodes entry $n is not a node"
        done

        # subnets
        local sn cidr gw vlan exips ip r label other ocidr
        while IFS=$'\t' read -r sn cidr gw vlan exips; do
            [[ -z $sn ]] && continue
            label="provider $pn subnet $sn"
            if ! valid_cidr "$cidr" || ! cidr_is_canonical "$cidr"; then
                fail "$label: cidrBlock '$cidr' is not a network address"; continue
            fi
            if [[ -n $gw ]]; then
                cidr_contains "$cidr" "$gw" && pass "$label: $cidr, gateway $gw, vlanID ${vlan:-0}" ||
                    fail "$label: gateway $gw is outside $cidr"
            else
                warn "$label: no gateway"
            fi
            for ip in $exips; do
                range_within "$ip" "$cidr" || warn "$label: excludeIPs entry $ip is outside $cidr"
            done
            for r in $(km .spec.networking.kubeOVN.podCIDR) $(km .spec.networking.serviceCIDR) 100.64.0.0/16; do
                ranges_overlap "$r" "$cidr" && fail "$label: $cidr overlaps $r"
            done
            if ((HAVE_ENV)); then
                for net in "${NETS[@]}"; do
                    ranges_overlap "${NET_CIDR[$net]}" "$cidr" && fail "$label: $cidr overlaps node network $net ${NET_CIDR[$net]}"
                done
            fi
            while read -r other ocidr; do
                [[ -z $other || $other == "$pn/$sn" ]] && continue
                ranges_overlap "$ocidr" "$cidr" && fail "$label: $cidr overlaps provider subnet $other $ocidr"
            done <<<"$all_subnets"
            PROV_SUBNET_VLAN[$pn]+="$vlan "
        done < <(jq -r --arg p "$pn" '.[] | select(.name == $p) | .subnets[]? |
                  [.name, .cidrBlock, (.gateway // ""), (.vlanID // 0 | tostring), ((.excludeIPs // []) | join(" "))] | @tsv' <<<"$spec")

        # interface on the network nodes it lands on
        local targets=()
        for n in $network; do in_list "$n" "$excl" || targets+=("$n"); done
        if ((${#targets[@]} == 0)); then
            fail "provider network $pn: no network node left after excludeNodes ($excl)"
            continue
        fi
        info "provider network $pn: OVN bridge on $iface on ${targets[*]}${excl:+ (excluded: $excl)}"
        if ! ((HAVE_ENV)); then
            info "provider network $pn: no setup.env, interface $iface not checked on the nodes"
            continue
        fi
        local out l kind vid flags ipv4 master tagged=0 v
        for v in ${PROV_SUBNET_VLAN[$pn]:-}; do [[ $v != 0 ]] && tagged=1; done
        for n in "${targets[@]}"; do
            if [[ -z ${NODE_ROLE[$n]:-} ]]; then
                info "$n: not in setup.env, $iface not checked"; continue
            fi
            if ! out=$(node_cmd "$n" "ip -d -j link show dev $iface 2>/dev/null || echo '[]'; echo; ip -j -4 addr show dev $iface 2>/dev/null || echo '[]'" 2>/dev/null); then
                fail "$n: cannot query $iface over SSH"; continue
            fi
            l=$(head -n1 <<<"$out" | jq -c '.[0] // empty' 2>/dev/null)
            if [[ -z $l ]]; then
                fail "$n: provider $pn interface $iface missing (add $n to excludeNodes if it has no such NIC)"
                continue
            fi
            flags=$(jq -r '.flags | join(",")' <<<"$l")
            kind=$(jq -r '.linkinfo.info_kind // "device"' <<<"$l")
            vid=$(jq -r '.linkinfo.info_data.id // empty' <<<"$l")
            master=$(jq -r '.master // empty' <<<"$l")
            ipv4=$(sed -n 3p <<<"$out" | jq -r '[.[]?.addr_info[]? | select(.family == "inet") | .local] | join(" ")' 2>/dev/null)
            local problems=()
            [[ ,$flags, == *,LOWER_UP,* ]] || problems+=("no carrier ($flags)")
            [[ -z $ipv4 ]] || problems+=("carries IPv4 $ipv4")
            if ((${#problems[@]})); then
                fail "$n: provider $pn $iface: $(joinc "${problems[@]}")"
            else
                local what=$kind; [[ $kind == vlan ]] && what="VLAN $vid device"
                pass "$n: $iface (provider $pn) up, no IPv4, $what${master:+, attached to $master}"
            fi
            if [[ $kind == vlan ]] && ((tagged)); then
                warn "$n: $iface is already a kernel VLAN device (VLAN $vid) and $pn subnets set a vlanID: frames would be tagged twice; use vlanID 0"
            fi
            if [[ $origin == default && -n ${PROV_VLAN_BY_IFACE[$iface]:-} && $kind == vlan && $vid != "${PROV_VLAN_BY_IFACE[$iface]}" ]]; then
                fail "$n: $iface has VLAN $vid, setup.env expects ${PROV_VLAN_BY_IFACE[$iface]}"
            fi
        done
    done < <(jq -r '.[] | [.name, .interface, ((.excludeNodes // []) | join(" "))] | @tsv' <<<"$spec")

    # setup.env providers missing from the KMetal resource
    if ((HAVE_ENV)); then
        local km_ifaces
        km_ifaces=$(jq -r '.[].interface' <<<"$spec" | tr '\n' ' ')
        for p in $PROVIDER_NETWORKS; do
            in_list "${PROV_IFACE[$p]}" "$km_ifaces" ||
                warn "setup.env provider network $p (${PROV_IFACE[$p]}) is not a providerNetwork of the KMetal resource"
        done
    fi
}

# tenant subject derived from spec.multiTenancy.users
TEN_GROUP="" TEN_SA_NS=""
resolve_tenant_subject() {
    local u
    u=$(km '[.spec.multiTenancy.users[]? | select(.kind == "Group" and (.name | startswith("system:serviceaccounts:")))][0] | .name')
    [[ -n $u ]] || return 1
    TEN_GROUP=$u
    TEN_SA_NS=${u#system:serviceaccounts:}
}

km_tenancy() {
    local users
    users=$(km '.spec.multiTenancy.users[]? | "\(.kind):\(.name)"' | tr '\n' ' ')
    if [[ -z $users ]]; then
        warn "spec.multiTenancy.users is empty: tenancy installed but inactive"
    else
        pass "multiTenancy users: $users"
    fi
    local cc
    cc=$(kubectl get capsuleconfigurations -o json 2>/dev/null | jq -r '.items[].metadata.name')
    [[ -n $cc ]] && pass "CapsuleConfiguration: $(tr '\n' ' ' <<<"$cc")" || fail "no CapsuleConfiguration"
    [[ -n $users ]] || return

    local kind name as=() probe="kmetal-validate-probe-$RUN_ID" out
    read -r kind name < <(km '.spec.multiTenancy.users[0] | "\(.kind) \(.name)"')
    case $kind in
        Group)
            if [[ $name == system:serviceaccounts:* ]]; then
                as=(--as="system:serviceaccount:${name#system:serviceaccounts:}:kmetal-validate-probe")
            else
                as=(--as=kmetal-validate-probe)
            fi
            as+=(--as-group="$name" --as-group=system:authenticated) ;;
        User) as=(--as="$name") ;;
        ServiceAccount) as=(--as="$name") ;;
        *) info "multiTenancy user kind $kind: probe skipped"; return ;;
    esac
    register_cleanup "kubectl delete namespace $probe --ignore-not-found --wait=false >/dev/null 2>&1"
    if out=$(kubectl create namespace "$probe" "${as[@]}" 2>&1); then
        local t
        t=$(kubectl get namespace "$probe" -o jsonpath='{.metadata.labels.capsule\.clastix\.io/tenant}')
        if [[ -n $t ]]; then
            info "namespace created and assigned to tenant $t"
        else
            fail "a $kind:$name member created a namespace with no capsule.clastix.io/tenant label: Capsule does not know that subject"
        fi
    else
        pass "Capsule admission rejected a namespace for a $kind:$name member owning no Tenant"
        detail <<<"$(head -n 2 <<<"$out")"
    fi
}

E2E_CC="" CAPI_V1BETA2=0

km_capi() {
    local kind kw j name ready ver
    for kind in coreproviders:cluster-api bootstrapproviders:kubeadm infrastructureproviders:kubevirt controlplaneproviders:kamaji; do
        kw=${kind#*:}; kind=${kind%%:*}
        j=$(kubectl get "$kind.operator.cluster.x-k8s.io" -n "$NS_CAPI" -o json 2>/dev/null) ||
            { fail "$kind API not served"; continue; }
        read -r name ready ver < <(jq -r --arg k "$kw" '[.items[] | select(.metadata.name | contains($k))][0] |
            "\(.metadata.name // "-") \([.status.conditions[]? | select(.type == "Ready") | .status] | first // "Unknown") \(.status.installedVersion // .spec.version // "?")"' <<<"$j")
        if [[ $name == - || $name == null ]]; then fail "no $kind matching '$kw' in $NS_CAPI"
        elif [[ $ready == True ]]; then pass "$kind $name $ver Ready"
        else fail "$kind $name $ver Ready=$ready"; fi
    done
    local ccs
    ccs=$(resolve_cc)
    [[ -n $ccs ]] && pass "ClusterClasses in $NS_CAPI: $ccs" || fail "no ClusterClass in $NS_CAPI"
    [[ -n $E2E_CLUSTERCLASS && -z $E2E_CC ]] && fail "E2E_CLUSTERCLASS $E2E_CLUSTERCLASS does not exist in $NS_CAPI"
    [[ -n $E2E_CC ]] && info "e2e will use ClusterClass $E2E_CC"
}

# resolve_cc - sets E2E_CC and CAPI_V1BETA2, prints the ClusterClass names (no output checks)
resolve_cc() {
    local ccs name
    kubectl api-versions | grep -qx cluster.x-k8s.io/v1beta2 && CAPI_V1BETA2=1
    ccs=$(kubectl get clusterclasses.cluster.x-k8s.io -n "$NS_CAPI" -o jsonpath='{.items[*].metadata.name}' 2>/dev/null)
    E2E_CC=""
    if [[ -n $E2E_CLUSTERCLASS ]]; then
        in_list "$E2E_CLUSTERCLASS" "$ccs" && E2E_CC=$E2E_CLUSTERCLASS
    else
        for name in kubevirt-standard kubevirt-expert kubevirt-kubeadm $ccs; do
            in_list "$name" "$ccs" && { E2E_CC=$name; break; }
        done
    fi
    echo "$ccs"
}

km_kubevirt() {
    local ph
    ph=$(kubectl get kubevirt -n "$NS_KUBEVIRT" -o jsonpath='{.items[0].status.phase}' 2>/dev/null)
    [[ $ph == Deployed ]] && pass "KubeVirt Deployed" || fail "KubeVirt phase ${ph:-not found} in $NS_KUBEVIRT"
    ph=$(kubectl get cdi -o jsonpath='{.items[0].status.phase}' 2>/dev/null)
    [[ $ph == Deployed ]] && pass "CDI Deployed" || warn "CDI phase ${ph:-not found}"
}

declare -A ARTIFACT_FOR=()
TAGS=()

resolve_images() { # fills TAGS and ARTIFACT_FOR[tag]=name|phase|goldenBound
    local arts tag maj min pat re name phase golden
    mapfile -t TAGS < <(km '.spec.clusterClass.values.osArtifact.tags[]?')
    arts=$(kubectl get osartifacts -n "$NS_IMAGES" -o json 2>/dev/null | jq -r '.items[] | "\(.metadata.name) \(.status.phase // "Unknown")"')
    for tag in "${TAGS[@]}"; do
        [[ $tag =~ ^v?([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || continue
        maj=${BASH_REMATCH[1]} min=${BASH_REMATCH[2]} pat=${BASH_REMATCH[3]}
        re="(^|-)v${maj}-?${min}-?${pat}(-|$)"
        while read -r name phase; do
            [[ -n $name && $name =~ $re ]] || continue
            golden=$(kubectl get pvc "$name-golden" -n "$NS_IMAGES" -o jsonpath='{.status.phase}' 2>/dev/null)
            ARTIFACT_FOR[$tag]="$name|$phase|${golden:-Missing}"
            break
        done <<<"$arts"
    done
}

km_crds() {
    local c
    for c in clusters.cluster.x-k8s.io kamajicontrolplanes.controlplane.cluster.x-k8s.io \
             virtualmachines.kubevirt.io vpcclaims.network.kmetal.io subnetclaims.network.kmetal.io \
             eipclaims.network.kmetal.io providernetworks.network.kmetal.io tenants.capsule.clastix.io \
             volumesnapshots.snapshot.storage.k8s.io osartifacts.build.kairos.io; do
        kubectl get crd "$c" >/dev/null 2>&1 && pass "CRD $c" || fail "CRD $c missing"
    done
    resolve_images
    ((${#TAGS[@]})) || { fail "spec.clusterClass.values.osArtifact.tags is empty: no OS image to boot tenant workers"; return; }
    local tag name phase golden
    for tag in "${TAGS[@]}"; do
        if [[ -z ${ARTIFACT_FOR[$tag]:-} ]]; then
            fail "osArtifact tag $tag: no OSArtifact in $NS_IMAGES"
            continue
        fi
        IFS='|' read -r name phase golden <<<"${ARTIFACT_FOR[$tag]}"
        if [[ $phase == Ready && $golden == Bound ]]; then
            pass "osArtifact tag $tag: OSArtifact $name Ready, $name-golden Bound"
        else
            fail "osArtifact tag $tag: OSArtifact $name $phase, $name-golden $golden"
        fi
    done
}

# --------------------------------------------------------------------------
# e2e
# --------------------------------------------------------------------------
declare -A ENV_NS=() ENV_CLUSTER=() ENV_WORKERS=() ENV_TENANT=() TK_MODE=() TK_API=() TENANT_SA=() CLUSTER_UP=()
E2E_TAG="" E2E_ARTIFACT="" TK_NODE="" E2E_SA_NS_READY=0

# tk ENV args...       kubectl against the tenant cluster of ENV (no stdin)
# tk_apply ENV < json  kubectl apply -f - against it
tk() {
    local e=$1; shift
    if [[ ${TK_MODE[$e]} == direct ]]; then
        kubectl --kubeconfig "$WORK/kc-$e" "$@" </dev/null
    else
        local q; printf -v q '%q ' "$@"
        { base64 -w0 "$WORK/kc-$e"; echo; } | node_cmd "$TK_NODE" \
            "kc=\$(mktemp) && IFS= read -r l && printf '%s' \"\$l\" | base64 -d > \"\$kc\" && kubectl --kubeconfig \"\$kc\" $q; rc=\$?; rm -f \"\$kc\"; exit \$rc"
    fi
}

tk_apply() {
    local e=$1
    if [[ ${TK_MODE[$e]} == direct ]]; then
        kubectl --kubeconfig "$WORK/kc-$e" apply -f - >/dev/null
    else
        { base64 -w0 "$WORK/kc-$e"; echo; cat; } | node_cmd "$TK_NODE" \
            "kc=\$(mktemp) && IFS= read -r l && printf '%s' \"\$l\" | base64 -d > \"\$kc\" && kubectl --kubeconfig \"\$kc\" apply -f - >/dev/null; rc=\$?; rm -f \"\$kc\"; exit \$rc"
    fi
}

tk_pod_done() { # tk_pod_done ENV NS POD TIMEOUT
    local end=$((SECONDS + $4)) ph
    while ((SECONDS < end)); do
        ph=$(tk "$1" get pod "$3" -n "$2" -o jsonpath='{.status.phase}' 2>/dev/null)
        [[ $ph == Succeeded ]] && return 0
        [[ $ph == Failed ]] && return 1
        sleep 5
    done
    return 2
}

# owner_user TENANT - the ServiceAccount username owning TENANT
owner_user() { echo "system:serviceaccount:$TEN_SA_NS:${TENANT_SA[$1]}"; }

# kas TENANT kubectl-args... - kubectl impersonating the owner of TENANT
kas() {
    local t=$1; shift
    kubectl "$@" --as="$(owner_user "$t")" --as-group="$TEN_GROUP" --as-group=system:authenticated
}

e2e_prepare() {
    [[ -n $KM_JSON ]] || load_km || { fail "no KMetal resource"; return 1; }
    resolve_tenant_subject || {
        fail "e2e needs a multiTenancy Group system:serviceaccounts:<namespace>; found: $(km '[.spec.multiTenancy.users[]? | "\(.kind):\(.name)"] | join(" ")')"
        return 1
    }
    ((${#TAGS[@]})) || resolve_images
    resolve_cc >/dev/null
    [[ -n $E2E_CC ]] || { fail "no usable ClusterClass in $NS_CAPI for e2e (E2E_CLUSTERCLASS=${E2E_CLUSTERCLASS:-auto})"; return 1; }

    E2E_TAG=${E2E_K8S_VERSION:-${TAGS[0]:-}}
    [[ -n $E2E_TAG ]] || { fail "no Kubernetes version: osArtifact.tags is empty and E2E_K8S_VERSION unset"; return 1; }
    in_list "$E2E_TAG" "${TAGS[*]}" || { fail "E2E_K8S_VERSION $E2E_TAG is not in osArtifact.tags (${TAGS[*]})"; return 1; }
    local phase golden
    IFS='|' read -r E2E_ARTIFACT phase golden <<<"${ARTIFACT_FOR[$E2E_TAG]:-}"
    if [[ -z $E2E_ARTIFACT || $phase != Ready || $golden != Bound ]]; then
        fail "image for $E2E_TAG not usable: OSArtifact ${E2E_ARTIFACT:-missing} ${phase:-}, golden ${golden:-}"
        return 1
    fi
    TK_NODE=${TENANT_KUBECTL_NODE:-}
    ((HAVE_ENV)) && [[ -z $TK_NODE ]] && TK_NODE=$(first_node cp)
    pass "e2e: run $RUN_ID, ClusterClass $E2E_CC, Kubernetes $E2E_TAG, OSArtifact $E2E_ARTIFACT, tenant group $TEN_GROUP"
}

# e2e_tenant NAME - ServiceAccount NAME (the owner) and Capsule Tenant NAME
e2e_tenant() {
    local t=$1
    if ((! E2E_SA_NS_READY)); then
        if ! kubectl get namespace "$TEN_SA_NS" >/dev/null 2>&1; then
            jq -n --arg n "$TEN_SA_NS" --argjson lb "$(labels)" '{apiVersion: "v1", kind: "Namespace", metadata: {name: $n, labels: $lb}}' | kapply
            register_cleanup "kubectl delete namespace $TEN_SA_NS --wait=false >/dev/null 2>&1"
            info "created namespace $TEN_SA_NS for tenant ServiceAccounts"
        fi
        E2E_SA_NS_READY=1
    fi
    TENANT_SA[$t]=$t
    jq -n --arg n "$t" --arg ns "$TEN_SA_NS" --argjson lb "$(labels)" \
        '{apiVersion: "v1", kind: "ServiceAccount", metadata: {name: $n, namespace: $ns, labels: $lb}}' | kapply
    register_cleanup "kubectl delete serviceaccount $t -n $TEN_SA_NS --ignore-not-found >/dev/null 2>&1"
    jq -n --arg n "$t" --arg u "$(owner_user "$t")" --argjson lb "$(labels)" '
      {apiVersion: "capsule.clastix.io/v1beta2", kind: "Tenant",
       metadata: {name: $n, labels: $lb},
       spec: {owners: [{kind: "ServiceAccount", name: $u}]}}' | kapply ||
        { fail "cannot create Tenant $t"; return 1; }
    register_cleanup "kubectl delete tenant $t --ignore-not-found --wait=true --timeout=300s >/dev/null 2>&1"
    ten_ready() {
        local j; j=$(kubectl get tenant "$1" -o json 2>/dev/null) || return 1
        jq -e '(([.status.conditions[]? | select(.type == "Ready") | .status] | first) == "True") or .status.state == "Active"' <<<"$j" >/dev/null
    }
    if poll 120 3 ten_ready "$t"; then pass "Tenant $t Ready, owner $(owner_user "$t")"
    else fail "Tenant $t not Ready in 120s"; return 1; fi
}

# e2e_env KEY - environment ENV_NS[KEY] of tenant ENV_TENANT[KEY], with a VPC and a subnet
e2e_env() {
    local e=$1 ns=${ENV_NS[$1]} t=${ENV_TENANT[$1]} out
    if ! out=$(kas "$t" create namespace "$ns" 2>&1); then
        fail "owner of $t cannot create environment $ns: $out"
        return 1
    fi
    register_cleanup "kubectl delete namespace $ns --wait=true --timeout=600s >/dev/null 2>&1"
    kubectl label namespace "$ns" "$LABEL_KEY=$RUN_ID" >/dev/null
    local got
    got=$(kubectl get namespace "$ns" -o jsonpath='{.metadata.labels.capsule\.clastix\.io/tenant}')
    [[ $got == "$t" ]] && pass "environment $ns created by the owner of $t, assigned to $t" ||
        fail "environment $ns has capsule.clastix.io/tenant='$got', expected $t"
    [[ $(kas "$t" auth can-i create subnetclaims.network.kmetal.io -n "$ns" 2>/dev/null) == yes ]] ||
        info "the owner of $t cannot create SubnetClaims in $ns; the claims are applied as admin"

    jq -n --arg ns "$ns" --arg cidr "$E2E_SUBNET_CIDR" --arg gw "$(int2ip $(( $(cut -d' ' -f1 < <(cidr_range "$E2E_SUBNET_CIDR")) + 1 )))" \
        --argjson lb "$(labels)" '
      {apiVersion: "v1", kind: "List", items: [
        {apiVersion: "network.kmetal.io/v1alpha1", kind: "VpcClaim",
         metadata: {name: "main", namespace: $ns, labels: $lb}, spec: {externalAccess: true}},
        {apiVersion: "network.kmetal.io/v1alpha1", kind: "SubnetClaim",
         metadata: {name: "primary", namespace: $ns, labels: $lb},
         spec: {cidrBlock: $cidr, gateway: $gw, protocol: "IPv4", excludeIps: [$gw],
                attachment: {managed: true}, enableSnatRule: true}}]}' | kapply ||
        { fail "cannot create VpcClaim/SubnetClaim in $ns"; return 1; }
    register_cleanup "kubectl delete vpcclaim main -n $ns --ignore-not-found --wait=true --timeout=300s >/dev/null 2>&1"
    register_cleanup "kubectl delete subnetclaim primary -n $ns --ignore-not-found --wait=true --timeout=300s >/dev/null 2>&1"
    local k
    for k in vpcclaim:main subnetclaim:primary; do
        if poll 300 5 is_ready "${k%%:*}" "${k#*:}" "$ns"; then
            pass "$ns: ${k%%:*} ${k#*:} Ready"
        else
            fail "$ns: ${k%%:*} ${k#*:} not Ready in 300s"
            kubectl get "${k%%:*}" "${k#*:}" -n "$ns" -o jsonpath='{.status}' 2>/dev/null | detail; echo
            return 1
        fi
    done
    local v4
    v4=$(table_col V4 eipclaim external -n "$ns")
    [[ -n $v4 ]] && pass "$ns: router-port EipClaim external on $v4" || warn "$ns: no EipClaim external with an address"
}

# e2e_subnets K1 K2 - the two SubnetClaims are distinct Kube-OVN subnets, same CIDR, different VPCs
e2e_subnets() {
    local n1=${ENV_NS[$1]} n2=${ENV_NS[$2]} s1 s2 c1 c2 v1 v2
    s1=$(table_col SUBNET subnetclaim primary -n "$n1")
    s2=$(table_col SUBNET subnetclaim primary -n "$n2")
    if [[ -z $s1 || -z $s2 ]]; then info "derived Kube-OVN subnet names not reported; overlap shown by the claims only"; return; fi
    read -r c1 v1 < <(kubectl get subnets.kubeovn.io "$s1" -o jsonpath='{.spec.cidrBlock} {.spec.vpc}' 2>/dev/null)
    read -r c2 v2 < <(kubectl get subnets.kubeovn.io "$s2" -o jsonpath='{.spec.cidrBlock} {.spec.vpc}' 2>/dev/null)
    if [[ $s1 != "$s2" && $c1 == "$c2" && $v1 != "$v2" ]]; then
        pass "overlapping subnets: $s1 (VPC $v1) and $s2 (VPC $v2) both on $c1"
    else
        fail "subnets $s1 ($c1, VPC $v1) and $s2 ($c2, VPC $v2) are not two isolated copies of $E2E_SUBNET_CIDR"
    fi
}

# e2e_rbac SRC DST - the owner of SRC's tenant has no access to DST's tenant
e2e_rbac() {
    local st=${ENV_TENANT[$1]} own=${ENV_NS[$1]} dt=${ENV_TENANT[$2]} dst=${ENV_NS[$2]} dc=${ENV_CLUSTER[$2]}
    if [[ $(kas "$st" auth can-i get pods -n "$own" 2>/dev/null) != yes ]]; then
        warn "the owner of $st cannot read pods in its own environment $own; the denials below prove little"
    fi
    local checks=(
        "get pods -n $dst" "create pods -n $dst" "get secrets -n $dst"
        "get secrets/$dc-kubeconfig -n $dst" "get clusters.cluster.x-k8s.io -n $dst"
        "create vpcclaims.network.kmetal.io -n $dst" "create subnetclaims.network.kmetal.io -n $dst"
        "create eipclaims.network.kmetal.io -n $dst" "delete namespaces/$dst"
        "update tenants.capsule.clastix.io/$dt"
    )
    local c allowed=()
    for c in "${checks[@]}"; do
        # shellcheck disable=SC2086
        [[ $(kas "$st" auth can-i $c 2>/dev/null) == yes ]] && allowed+=("$c")
    done
    if ((${#allowed[@]})); then
        fail "the owner of $st is allowed on tenant $dt: $(joinc "${allowed[@]}")"
    else
        pass "the owner of $st is denied all ${#checks[@]} probed actions on tenant $dt (environment $dst, its claims, kubeconfig, Tenant)"
    fi
}

e2e_cluster_apply() { # e2e_cluster_apply KEY
    local e=$1 ns=${ENV_NS[$1]} name=${ENV_CLUSTER[$1]} cc vars wclass
    cc=$(kubectl get clusterclasses.cluster.x-k8s.io "$E2E_CC" -n "$NS_CAPI" -o json)
    wclass=$(jq -r '.spec.workers.machineDeployments[0].class // "default-worker"' <<<"$cc")
    vars=$(jq -c --arg ds "$E2E_DATASTORE" --arg size "$E2E_MACHINE_SIZE" --arg art "$E2E_ARTIFACT" '
        [.spec.variables[]?.name] as $d |
        [ (if ($d | index("controlPlane")) then {name: "controlPlane", value: {dataStoreName: $ds, network: {serviceType: "LoadBalancer"}}} else empty end),
          (if ($d | index("machineSize")) then {name: "machineSize", value: $size} else empty end),
          (if ($d | index("osImage")) then {name: "osImage", value: {artifactName: $art}} else empty end),
          (if ($d | index("network")) then {name: "network", value: {subnet: "primary"}} else empty end) ]' <<<"$cc")
    jq -e 'map(.name) | index("network")' <<<"$vars" >/dev/null ||
        warn "ClusterClass $E2E_CC declares no 'network' variable: workers may not join the SubnetClaim"
    jq -e 'map(.name) | index("osImage")' <<<"$vars" >/dev/null ||
        info "ClusterClass $E2E_CC has no osImage variable; the image follows the version $E2E_TAG"
    jq -n --arg n "$name" --arg ns "$ns" --arg cc "$E2E_CC" --arg cns "$NS_CAPI" --arg ver "$E2E_TAG" \
        --arg wc "$wclass" --argjson rep "${ENV_WORKERS[$e]}" --argjson vars "$vars" --argjson v2 "$CAPI_V1BETA2" \
        --arg pod "$E2E_POD_CIDR" --arg svc "$E2E_SVC_CIDR" --argjson lb "$(labels)" '
      {apiVersion: (if $v2 == 1 then "cluster.x-k8s.io/v1beta2" else "cluster.x-k8s.io/v1beta1" end),
       kind: "Cluster", metadata: {name: $n, namespace: $ns, labels: $lb},
       spec: {clusterNetwork: {pods: {cidrBlocks: [$pod]}, services: {cidrBlocks: [$svc]}},
              topology: ((if $v2 == 1 then {classRef: {name: $cc, namespace: $cns}} else {class: $cc, classNamespace: $cns} end)
                + {version: $ver, variables: $vars,
                   workers: {machineDeployments: [{class: $wc, name: "md-0", replicas: $rep}]}})}}' | kapply ||
        { fail "cannot create Cluster $ns/$name"; return 1; }
    register_cleanup "e2e_delete_cluster $ns $name"
    info "Cluster $ns/$name applied: $E2E_CC, $E2E_TAG, ${ENV_WORKERS[$e]} worker(s)"
}

# Deleting one test cluster starts the deletion of all of them, so they go down in parallel
e2e_delete_cluster() {
    kubectl delete clusters.cluster.x-k8s.io -A -l "$LABEL_KEY=$RUN_ID" --wait=false >/dev/null 2>&1
    gone() { ! kubectl get cluster "$2" -n "$1" >/dev/null 2>&1; }
    poll 1200 10 gone "$1" "$2" && info "Cluster $1/$2 deleted" ||
        warn "Cluster $1/$2 still present after 20m"
}

cluster_up() { # cluster_up KEY
    local ns=${ENV_NS[$1]} name=${ENV_CLUSTER[$1]} j m
    j=$(kubectl get cluster "$name" -n "$ns" -o json 2>/dev/null) || return 1
    jq -e '[.status.conditions[]? | select(.type == "Available" or .type == "Ready") | .status] | any(. == "True")' <<<"$j" >/dev/null || return 1
    m=$(kubectl get machines -n "$ns" -l "cluster.x-k8s.io/cluster-name=$name" -o json 2>/dev/null |
        jq '[.items[] | select(.status.phase == "Running")] | length')
    ((m >= ${ENV_WORKERS[$1]}))
}

# e2e_wait_clusters KEY... - waits for all of them together; sets CLUSTER_UP[KEY]
e2e_wait_clusters() {
    local timeout end e left=() last=0
    timeout=$(to_seconds "$CLUSTER_TIMEOUT")
    end=$((SECONDS + timeout))
    while :; do
        left=()
        for e in "$@"; do
            [[ -n ${CLUSTER_UP[$e]:-} ]] && continue
            if cluster_up "$e"; then
                CLUSTER_UP[$e]=1
                pass "Cluster ${ENV_NS[$e]}/${ENV_CLUSTER[$e]} available, ${ENV_WORKERS[$e]} machine(s) Running"
            else
                left+=("$e")
            fi
        done
        ((${#left[@]} == 0)) && return 0
        if ((SECONDS >= end)); then
            for e in "${left[@]}"; do
                fail "Cluster ${ENV_NS[$e]}/${ENV_CLUSTER[$e]} not available in $CLUSTER_TIMEOUT"
                kubectl get cluster,kamajicontrolplane,machines,vmi -n "${ENV_NS[$e]}" 2>&1 | detail
                kubectl get events -n "${ENV_NS[$e]}" --sort-by=.lastTimestamp 2>/dev/null | tail -n 10 | detail
            done
            return 1
        fi
        if ((SECONDS - last >= 120)); then
            last=$SECONDS
            for e in "${left[@]}"; do
                info "waiting for ${ENV_CLUSTER[$e]}: $(kubectl get machines -n "${ENV_NS[$e]}" -o jsonpath='{range .items[*]}{.metadata.name}={.status.phase} {end}' 2>/dev/null)"
            done
        fi
        sleep 15
    done
}

e2e_access() { # e2e_access KEY
    local e=$1 ns=${ENV_NS[$1]} name=${ENV_CLUSTER[$1]} svc ip port code
    kubectl get secret "$name-kubeconfig" -n "$ns" -o jsonpath='{.data.value}' 2>/dev/null | base64 -d >"$WORK/kc-$e"
    [[ -s $WORK/kc-$e ]] || { fail "$ns: Secret $name-kubeconfig missing"; return 1; }
    svc=$(kubectl get svc -n "$ns" -o json | jq -r --arg n "$name" '
        [.items[] | select(.spec.type == "LoadBalancer")
         | select(.metadata.labels["kamaji.clastix.io/name"] == $n or .metadata.name == $n)][0]
        | "\(.status.loadBalancer.ingress[0].ip // "") \(.spec.ports[0].port // 6443)"')
    read -r ip port <<<"$svc"
    [[ -n $ip ]] || { fail "$ns: no LoadBalancer address for the $name control plane"; return 1; }
    TK_API[$e]="$ip:$port"
    local in=0 r
    while read -r r; do [[ -n $r ]] && range_contains "$r" "$ip" && in=1; done < <(km '.spec.networking.loadBalancer.tenantControlPlanes.addresses[]?')
    ((in)) && pass "$name control plane on $ip:$port (tenantControlPlanes pool)" ||
        warn "$name control plane on $ip:$port, outside loadBalancer.tenantControlPlanes"
    sed -i -E "s#^([[:space:]]*server:[[:space:]]*).*#\1https://$ip:$port#" "$WORK/kc-$e"
    chmod 600 "$WORK/kc-$e"

    local mode=$TENANT_ACCESS
    if [[ $mode == auto ]]; then
        code=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "https://$ip:$port/healthz" 2>/dev/null)
        if [[ $code != 000 && -n $code ]]; then mode=direct
        elif ((HAVE_ENV)); then mode=ssh
        else fail "tenant API $ip:$port unreachable from here and no setup.env for an SSH hop"; return 1; fi
    fi
    if [[ $mode == ssh ]]; then
        ((HAVE_ENV)) && [[ -n $TK_NODE ]] || { fail "TENANT_ACCESS=ssh needs setup.env"; return 1; }
        code=$(node_cmd "$TK_NODE" "curl -sk -o /dev/null -m 5 -w '%{http_code}' https://$ip:$port/healthz" 2>/dev/null)
        if [[ $code == 000 || -z $code ]]; then
            fail "tenant API $ip:$port unreachable from $TK_NODE (tenant VLAN / L2 advertisement)"
            return 1
        fi
        node_cmd "$TK_NODE" "command -v kubectl >/dev/null" || { fail "kubectl not installed on $TK_NODE"; return 1; }
        pass "tenant API $ip:$port reachable from $TK_NODE; tenant kubectl runs there"
    else
        pass "tenant API $ip:$port reachable from this machine"
    fi
    TK_MODE[$e]=$mode
}

# e2e_inside KEY [basic] - nodes and egress; full also tests storage and, for env a, cross-node traffic
e2e_inside() {
    local e=$1 level=${2:-full} ns=${ENV_NS[$1]} name=${ENV_CLUSTER[$1]}
    nodes_ready() {
        local n
        n=$(tk "$e" get nodes -o json 2>/dev/null | jq '[.items[] | select(any(.status.conditions[]; .type == "Ready" and .status == "True"))] | length')
        [[ -n $n ]] && ((n >= ${ENV_WORKERS[$e]}))
    }
    if poll 900 15 nodes_ready; then
        pass "$name: ${ENV_WORKERS[$e]} node(s) Ready"
    else
        fail "$name: nodes not Ready in 15m (no CNI? check: kubectl get clustersummaries -n $ns)"
        tk "$e" get nodes -o wide 2>&1 | detail
        kubectl get clustersummaries -n "$ns" 2>&1 | detail
        return 1
    fi

    local tns=kmetal-validate
    jq -n --arg n "$tns" '{apiVersion: "v1", kind: "Namespace", metadata: {name: $n}}' | tk_apply "$e"

    if [[ $level == full ]]; then
        # storage: PVC on the tenant default class, backed by tenantClassName on the under cluster
        { pvc_json data "$tns" "" 1Gi; pod_json writer "$tns" "$PROBE_IMAGE" '{}' data 'echo tenant > /data/f && sync && cat /data/f'; } |
            jq -s '{apiVersion: "v1", kind: "List", items: .}' | tk_apply "$e"
        if tk_pod_done "$e" "$tns" writer 420; then
            local uid sc tc
            uid=$(tk "$e" get pvc data -n "$tns" -o jsonpath='{.metadata.uid}')
            tc=$(km .spec.storage.tenantClassName)
            sc=$(kubectl get pvc -n "$ns" -o json | jq -r --arg u "$uid" '[.items[] | select(.metadata.name | contains($u)) | .spec.storageClassName][0] // empty')
            pass "$name: tenant PVC Bound, write/read OK"
            if [[ -z $sc ]]; then warn "$name: no under-cluster PVC in $ns carries the tenant PVC UID $uid"
            elif [[ $sc == "$tc" ]]; then pass "$name: tenant volume is backed by $tc on the under cluster"
            else fail "$name: tenant volume is backed by $sc, expected tenantClassName $tc"; fi
        else
            fail "$name: tenant PVC/pod did not complete in 7m"
            tk "$e" describe pvc data -n "$tns" 2>&1 | sed -n '/^Events:/,$p' | detail
        fi
    fi

    # egress through the VPC router and the provider network
    pod_json egress "$tns" "$CURL_IMAGE" '{}' "" "curl -sS -o /dev/null -m 10 -w '%{http_code}' $INTERNET_PROBE_URL" | tk_apply "$e"
    if tk_pod_done "$e" "$tns" egress 240; then
        pass "$name: egress to $INTERNET_PROBE_URL through the provider network (SNAT $(table_col V4 eipclaim external -n "$ns"))"
    else
        fail "$name: no egress from the tenant cluster to $INTERNET_PROBE_URL"
        tk "$e" logs egress -n "$tns" 2>&1 | tail -n 3 | detail
    fi

    [[ $level == full && $e == a ]] || return 0
    # overlay: worker VMs on different hosts talking to each other
    local hosts
    hosts=$(kubectl get vmi -n "$ns" -o json | jq -r '[.items[].status.nodeName] | unique | join(" ")')
    if (( $(wc -w <<<"$hosts") >= 2 )); then pass "$name: worker VMs on hosts $hosts"
    else warn "$name: all worker VMs on ${hosts:-?}; cross-host overlay traffic not exercised"; fi
    ((${ENV_WORKERS[$e]} >= 2)) || return 0
    jq -n --arg ns "$tns" --arg img "$TEST_IMAGE" '
      {apiVersion: "apps/v1", kind: "Deployment", metadata: {name: "xnode", namespace: $ns},
       spec: {replicas: 2, selector: {matchLabels: {app: "xnode"}},
              template: {metadata: {labels: {app: "xnode"}},
                spec: {affinity: {podAntiAffinity: {requiredDuringSchedulingIgnoredDuringExecution: [
                         {labelSelector: {matchLabels: {app: "xnode"}}, topologyKey: "kubernetes.io/hostname"}]}},
                       containers: [{name: "web", image: $img, ports: [{containerPort: 80}]}]}}}}' | tk_apply "$e"
    xnode_ready() { [[ $(tk "$e" get deploy xnode -n "$tns" -o jsonpath='{.status.readyReplicas}' 2>/dev/null) == 2 ]]; }
    if ! poll 300 5 xnode_ready; then fail "$name: cross-node test pods not ready"; return 0; fi
    local n0 ip1
    read -r n0 _ < <(tk "$e" get pods -n "$tns" -l app=xnode -o jsonpath='{range .items[*]}{.spec.nodeName} {.status.podIP}{"\n"}{end}' | head -n1)
    ip1=$(tk "$e" get pods -n "$tns" -l app=xnode -o jsonpath='{range .items[*]}{.spec.nodeName} {.status.podIP}{"\n"}{end}' | awk -v n="$n0" '$1 != n {print $2; exit}')
    pod_json xprobe "$tns" "$CURL_IMAGE" "{\"nodeName\":\"$n0\"}" "" "curl -sS -o /dev/null -m 5 http://$ip1/" | tk_apply "$e"
    tk_pod_done "$e" "$tns" xprobe 180 && pass "$name: pod on $n0 reaches pod $ip1 on the other worker" ||
        fail "$name: pod on $n0 cannot reach pod $ip1 on the other worker"
}

e2e_eip() {
    local e=a ns=${ENV_NS[a]} name=${ENV_CLUSTER[a]} v4 ext tns=kmetal-validate
    jq -n --arg ns "$ns" --argjson lb "$(labels)" '
      {apiVersion: "network.kmetal.io/v1alpha1", kind: "EipClaim",
       metadata: {name: "e2e", namespace: $ns, labels: $lb}, spec: {type: "nat"}}' | kapply ||
        { fail "cannot create EipClaim e2e"; return 1; }
    register_cleanup "kubectl delete eipclaim e2e -n $ns --ignore-not-found --wait=true --timeout=300s >/dev/null 2>&1"
    if ! poll 180 5 is_ready eipclaim e2e "$ns"; then fail "$ns: EipClaim e2e not Ready in 180s"; return 1; fi
    v4=$(table_col V4 eipclaim e2e -n "$ns")
    pass "$ns: EipClaim e2e Ready on ${v4:-?}"

    jq -n --arg ns "$tns" --arg img "$TEST_IMAGE" '
      {apiVersion: "v1", kind: "List", items: [
        {apiVersion: "apps/v1", kind: "Deployment", metadata: {name: "web", namespace: $ns},
         spec: {replicas: 1, selector: {matchLabels: {app: "web"}},
                template: {metadata: {labels: {app: "web"}},
                           spec: {containers: [{name: "web", image: $img, ports: [{containerPort: 80}]}]}}}},
        {apiVersion: "v1", kind: "Service",
         metadata: {name: "web", namespace: $ns, annotations: {"network.kmetal.io/eip-claim": "e2e"}},
         spec: {type: "LoadBalancer", loadBalancerClass: "kmetal", selector: {app: "web"},
                ports: [{port: 80, targetPort: 80}]}}]}' | tk_apply "$e"
    register_cleanup "tk a delete service web -n $tns --ignore-not-found --wait=true --timeout=120s >/dev/null 2>&1"
    svc_ip() { ext=$(tk "$e" get svc web -n "$tns" -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null); [[ -n $ext ]]; }
    if ! poll 300 5 svc_ip; then
        fail "$name: LoadBalancer Service with EipClaim e2e got no EXTERNAL-IP in 300s"
        tk "$e" describe svc web -n "$tns" 2>&1 | sed -n '/^Events:/,$p' | detail
        return 1
    fi
    [[ $ext == "$v4" ]] && pass "$name: Service EXTERNAL-IP $ext is the EipClaim address" ||
        fail "$name: Service EXTERNAL-IP $ext, EipClaim address $v4"
    local bound
    bound=$(table_col BOUND eipclaim e2e -n "$ns")
    [[ $bound == true || $bound == True ]] && pass "$ns: EipClaim e2e BOUND" || warn "$ns: EipClaim e2e BOUND=${bound:-?}"
    tk "$e" rollout status deploy/web -n "$tns" --timeout=180s >/dev/null 2>&1
    local from=$EIP_PROBE_FROM ok=1
    if [[ $from == local ]]; then
        curl -s -o /dev/null -m 5 "http://$ext/" || ok=0
    else
        node_cmd "$from" "curl -s -o /dev/null -m 5 http://$ext/" 2>/dev/null || ok=0
    fi
    ((ok)) && pass "http://$ext/ answers from $from" ||
        warn "http://$ext/ does not answer from $from (provider network routing is site-specific)"
}

# e2e_worker_ips KEY - worker addresses inside E2E_SUBNET_CIDR: tenant node InternalIPs and VMI interfaces
e2e_worker_ips() {
    local e=$1
    {
        [[ -n ${TK_MODE[$e]:-} ]] &&
            tk "$e" get nodes -o jsonpath='{range .items[*]}{.status.addresses[?(@.type=="InternalIP")].address}{"\n"}{end}' 2>/dev/null
        kubectl get vmi -n "${ENV_NS[$e]}" -o json 2>/dev/null | jq -r '.items[].status.interfaces[]?.ipAddress // empty'
    } | while read -r ip; do valid_ip "$ip" && cidr_contains "$E2E_SUBNET_CIDR" "$ip" && echo "$ip"; done | sort -u
}

# e2e_isolation SRC DST - a pod in SRC's cluster must not reach a worker of DST's cluster.
# The target is a DST address that SRC does not use itself, so a reply could only come from DST.
e2e_isolation() {
    local s=$1 d=$2 is id target tns=kmetal-validate pod="iso-$2"
    [[ -n ${TK_MODE[$s]:-} ]] || { info "${ENV_CLUSTER[$s]} not reachable: isolation towards ${ENV_CLUSTER[$d]} not probed"; return; }
    is=$(e2e_worker_ips "$s")
    id=$(e2e_worker_ips "$d")
    target=$(comm -13 <(echo "$is") <(echo "$id") | grep . | head -n1)
    if [[ -z $target ]]; then
        info "every ${ENV_CLUSTER[$d]} worker address is also used by ${ENV_CLUSTER[$s]}: isolation $s -> $d not probed"
        return
    fi
    pod_json "$pod" "$tns" "$CURL_IMAGE" '{}' "" "curl -sk -o /dev/null -m 5 https://$target:10250/healthz" | tk_apply "$s"
    case $(tk_pod_done "$s" "$tns" "$pod" 120; echo $?) in
        0) fail "${ENV_CLUSTER[$s]} reaches ${ENV_CLUSTER[$d]}'s worker $target:10250: VPCs are not isolated" ;;
        *) pass "${ENV_CLUSTER[$s]} cannot reach ${ENV_CLUSTER[$d]}'s worker $target: VPCs isolated" ;;
    esac
}

# e2e_overlap K1 K2 - show both address sets in the same CIDR, then probe isolation both ways
e2e_overlap() {
    local i1 i2 common
    i1=$(e2e_worker_ips "$1")
    i2=$(e2e_worker_ips "$2")
    info "${ENV_CLUSTER[$1]} workers: $(tr '\n' ' ' <<<"$i1")"
    info "${ENV_CLUSTER[$2]} workers: $(tr '\n' ' ' <<<"$i2")"
    common=$(comm -12 <(echo "$i1") <(echo "$i2") | grep . | paste -sd' ')
    if [[ -n $common ]]; then
        pass "the same worker addresses ($common) live in ${ENV_NS[$1]} and ${ENV_NS[$2]}: overlapping CIDRs coexist"
    else
        pass "${ENV_CLUSTER[$1]} and ${ENV_CLUSTER[$2]} both run in $E2E_SUBNET_CIDR, in separate VPCs"
    fi
    e2e_isolation "$1" "$2"
    e2e_isolation "$2" "$1"
}

# --- scenario "e2e": one tenant, two environments ---------------------------------
e2e_setup_envs() {
    local t="kv-$RUN_ID"
    ENV_TENANT[a]=$t; ENV_NS[a]="$t-a"; ENV_CLUSTER[a]="$t-a"; ENV_WORKERS[a]=$E2E_WORKERS_A
    ENV_TENANT[b]=$t; ENV_NS[b]="$t-b"; ENV_CLUSTER[b]="$t-b"; ENV_WORKERS[b]=$E2E_WORKERS_B
    e2e_tenant "$t" || return 1
    e2e_env a || return 1
    e2e_env b || return 1
    e2e_subnets a b
    e2e_cluster_apply a || return 1
    e2e_cluster_apply b || return 1
}

e2e_check_envs() {
    local e
    for e in a b; do
        if [[ -n ${CLUSTER_UP[$e]:-} ]]; then e2e_access "$e" && e2e_inside "$e" full; fi
    done
    [[ -n ${TK_MODE[a]:-} ]] && e2e_eip
    e2e_overlap a b
}

# --- scenario "e2e-tenants": two tenants, one environment each ---------------------
e2e_setup_tenants() {
    local t1="kv-$RUN_ID-t1" t2="kv-$RUN_ID-t2"
    ENV_TENANT[t1]=$t1; ENV_NS[t1]="$t1-env"; ENV_CLUSTER[t1]=$t1; ENV_WORKERS[t1]=$E2E_TENANT1_WORKERS
    ENV_TENANT[t2]=$t2; ENV_NS[t2]="$t2-env"; ENV_CLUSTER[t2]=$t2; ENV_WORKERS[t2]=$E2E_TENANT2_WORKERS
    e2e_tenant "$t1" || return 1
    e2e_tenant "$t2" || return 1
    e2e_env t1 || return 1
    e2e_env t2 || return 1
    e2e_rbac t1 t2
    e2e_rbac t2 t1
    e2e_subnets t1 t2
    e2e_cluster_apply t1 || return 1
    e2e_cluster_apply t2 || return 1
}

e2e_check_tenants() {
    local e
    for e in t1 t2; do
        if [[ -n ${CLUSTER_UP[$e]:-} ]]; then e2e_access "$e" && e2e_inside "$e" basic; fi
    done
    e2e_overlap t1 t2
}

km_e2e() {
    local do_envs=0 do_tenants=0 waits=() envs_ok=0 tenants_ok=0
    want e2e && do_envs=1
    want e2e-tenants && do_tenants=1
    e2e_prepare || return
    if ((do_envs)); then
        section "e2e"
        e2e_setup_envs && { envs_ok=1; waits+=(a b); }
    fi
    if ((do_tenants)); then
        section "e2e-tenants"
        e2e_setup_tenants && { tenants_ok=1; waits+=(t1 t2); }
    fi
    ((${#waits[@]})) || return
    section "e2e clusters"
    e2e_wait_clusters "${waits[@]}"
    if ((envs_ok)); then section "e2e"; e2e_check_envs; fi
    if ((tenants_ok)); then section "e2e-tenants"; e2e_check_tenants; fi
}

cmd_kmetal() {
    require kubectl jq helm curl base64 awk
    kube_ok || die "cannot reach the under cluster API (KUBECONFIG=${KUBECONFIG:-~/.kube/config})"
    HAVE_KUBE=1
    load_km
    ((HAVE_ENV)) && print_env
    if ((E2E_ONLY)); then ONLY=e2e,e2e-tenants; fi
    if ((NO_E2E)); then SKIP="${SKIP:+$SKIP,}e2e,e2e-tenants"; fi
    run_group platform km_platform
    run_group operator km_operator
    run_group metallb  km_metallb
    run_group storage  km_storage
    run_group nodes    km_nodes
    run_group providers km_providers
    run_group tenancy  km_tenancy
    run_group capi     km_capi
    run_group kubevirt km_kubevirt
    run_group crds     km_crds
    if want e2e || want e2e-tenants; then
        if ((FAIL_N > 0 && ! FORCE_E2E)); then
            section "e2e"
            warn "end-to-end tests skipped: $FAIL_N failures above (use --force-e2e to run anyway)"
        else
            section "e2e prepare"
            km_e2e
        fi
    fi
}

# ===========================================================================
# cleanup
# ===========================================================================
cmd_cleanup() {
    [[ -n $CLEAN_RUN_ID ]] || die "cleanup needs --run-id ID"
    require kubectl jq
    kube_ok || die "cannot reach the under cluster API"
    local sel="$LABEL_KEY=$CLEAN_RUN_ID" r
    section "cleanup $CLEAN_RUN_ID"
    kubectl delete clusters.cluster.x-k8s.io -A -l "$sel" --wait=false 2>&1 | detail
    none_left() { [[ -z $(kubectl get clusters.cluster.x-k8s.io -A -l "$sel" -o name 2>/dev/null) ]]; }
    poll 1200 10 none_left && pass "no Cluster left" || warn "Clusters still terminating"
    for r in eipclaims subnetclaims vpcclaims; do
        kubectl delete "$r.network.kmetal.io" -A -l "$sel" --wait=true --timeout=300s 2>&1 | detail
    done
    kubectl delete namespaces -l "$sel" --wait=true --timeout=600s 2>&1 | detail
    kubectl delete tenants.capsule.clastix.io -l "$sel" --wait=true --timeout=300s 2>&1 | detail
    kubectl delete serviceaccounts -A -l "$sel" 2>&1 | detail
    if ((HAVE_ENV)); then
        local n
        for n in "${NODE_LIST[@]}"; do node_exec "$n" <<<'ip link del kvtest0 2>/dev/null; true' 2>/dev/null; done
        info "removed tunnel test devices (kvtest0) from the nodes"
    fi
    local left
    left=$(kubectl get namespaces,tenants.capsule.clastix.io -l "$sel" -o name 2>/dev/null)
    [[ -z $left ]] && pass "nothing labelled $sel is left" || { fail "still present:"; detail <<<"$left"; }
}

# ===========================================================================
# selftest (IP math)
# ===========================================================================
cmd_selftest() {
    section "selftest"
    t() { if "$@"; then pass "$*"; else fail "$*"; fi; }
    f() { if ! "$@"; then pass "! $*"; else fail "! $*"; fi; }
    t valid_ip 10.206.241.10;            f valid_ip 10.206.241.256
    t valid_cidr 10.206.240.0/27;        f valid_cidr 10.206.240.0/33
    t cidr_is_canonical 10.206.240.64/27; f cidr_is_canonical 10.206.240.65/27
    t cidr_contains 10.206.241.0/25 10.206.241.126; f cidr_contains 10.206.241.0/25 10.206.241.128
    f ranges_overlap 10.206.240.0/27 10.206.240.32/27
    t ranges_overlap 10.16.0.0/16 10.16.255.0/24
    f ranges_overlap 10.16.0.0/16 10.36.0.0/16
    t range_within 10.206.240.2-10.206.240.9 10.206.240.0/27
    f range_within 10.206.240.15-10.206.240.40 10.206.240.0/27
    t range_contains 10.206.241.100-10.206.241.120 10.206.241.100
    f range_contains 10.206.241.100-10.206.241.120 10.206.241.121
    [[ $(int2ip "$(ip2int 172.22.104.11)") == 172.22.104.11 ]] && pass "ip2int/int2ip round trip" || fail "ip2int/int2ip"
    [[ $(to_seconds 30m) == 1800 && $(to_seconds 1h) == 3600 && $(to_seconds 90s) == 90 ]] && pass "to_seconds" || fail "to_seconds"
}

# ===========================================================================
# Group help: `kmetal-validate <undercluster|kmetal> help [group]`
# ===========================================================================
readonly UC_GROUPS="connectivity topology hardware os interfaces netplan addressing mesh internet encap"
readonly KM_GROUPS="platform operator metallb storage nodes providers tenancy capi kubevirt crds e2e e2e-tenants"

# group_help COMMAND GROUP - prints the help text; the first line is "group - summary"
group_help() {
    case "$1:$2" in
    undercluster:connectivity) cat <<'EOF'
connectivity - SSH and root access to every node (always runs)

  Opens one SSH session per node, in parallel, on its mgmt address as SSH_USER and
  runs a read-only script through SSH_SUDO (default "sudo -n"). The script collects
  the facts every later group evaluates: CPU, memory, disks, sysctls, modules, links,
  addresses and netplan. A node that fails here is skipped by every later group.

  FAIL  SSH or passwordless sudo does not work on a node
  INFO  the hostname differs from the NODES name
  Needs setup.env (NODES, SSH_USER, SSH_OPTS)
EOF
    ;;
    undercluster:topology) cat <<'EOF'
topology - cluster size, node registration, MetalLB exclusion label

  Counts the cp and worker rows of NODES. With a working kubeconfig, compares them
  with `kubectl get nodes` (names and InternalIP = mgmt address), and checks that no
  control plane carries node.kubernetes.io/exclude-from-external-load-balancers,
  which stops the MetalLB speakers from announcing there.

  FAIL  fewer than 1 control plane or 2 workers; exclusion label on a control plane
  WARN  fewer than 3 or an even number of control planes; node list mismatch
  Needs setup.env; kubeconfig optional
EOF
    ;;
    undercluster:hardware) cat <<'EOF'
hardware - lab minimum per node

  From the collected facts: nproc, MemTotal, root filesystem size, and the link
  speed of the physical parent of the mgmt interface (following VLAN links).

  WARN  below 8 CPU, 16 GiB RAM, 100 GB root, 1 Gb/s
  INFO  below the production profile (16 CPU, 64 GB, 500 GB, 10 Gb/s); unknown speed
  Needs setup.env, SSH
EOF
    ;;
    undercluster:os) cat <<'EOF'
os - Kubernetes and KubeVirt host prerequisites

  From the collected facts: swap, sysctls, kernel modules, tools and time sync.
  Workers must be able to run VMs.

  FAIL  swap on; net.ipv4.ip_forward != 1; ping missing;
        on workers: /dev/kvm missing or kvm_intel/kvm_amd not loaded
  WARN  fs.inotify.max_user_instances < 8192; br_netfilter not loaded;
        conntrack, socat or curl missing; clock not NTP-synchronised
  Needs setup.env, SSH
EOF
    ;;
    undercluster:interfaces) cat <<'EOF'
interfaces - VLAN interfaces, MTU and addresses as declared

  Reads `ip -d -j link` and `ip -j addr` from every node. For each network in
  NETWORKS: the interface exists, is UP with carrier, is a VLAN device with
  NET_VLAN, has NET_MTU, and carries the address from NODES. Provider interfaces
  (PROVIDER_NETWORKS) must exist on workers with PROV_VLAN and NO IPv4 address.

  FAIL  missing or down interface, wrong VLAN, MTU or address; IPv4 on a provider
  INFO  control plane without overlay (expected: the tunnel runs on network nodes);
        extra addresses; provider interface present on a control plane
  Needs setup.env, SSH
EOF
    ;;
    undercluster:netplan) cat <<'EOF'
netplan - interface persistence across reboots

  Looks for every declared interface as a key in `netplan get` on each node.

  WARN  a node-network interface (mgmt, tenant, overlay, ...) is not in netplan
  INFO  a provider interface is not in netplan: kMetal may already manage it
        (named as such when the KMetal resource lists it); netplan not installed
  Needs setup.env, SSH; kubeconfig optional
EOF
    ;;
    undercluster:addressing) cat <<'EOF'
addressing - non-overlapping address plan

  Compares every NET_CIDR pair. With a reachable KMetal resource, also compares
  them with kubeOVN.podCIDR, serviceCIDR, 100.64.0.0/16 (Kube-OVN join) and every
  provider subnet, and checks that the MetalLB ranges lie inside their network
  (tenantControlPlanes in tenant, management in mgmt) and contain no node address.

  FAIL  any overlap; a MetalLB range outside its network or covering a node IP
  Needs setup.env; kubeconfig optional
EOF
    ;;
    undercluster:mesh) cat <<'EOF'
mesh - full-mesh reachability on every node network

  Each node pings every peer address on each network both have, bound to that
  network's interface, all nodes in parallel:
    ping -c3 -i0.2 -W1 -q -I <iface> <peer>
  When NET_MTU > 1500, a do-not-fragment ping of MTU-28 bytes checks jumbo frames.

  FAIL  peer unreachable (100% loss)
  WARN  partial loss; jumbo frame does not pass end to end
  Needs setup.env, SSH
EOF
    ;;
    undercluster:internet) cat <<'EOF'
internet - egress only through the management network

  On every node and network: curl INTERNET_PROBE_URL and ping INTERNET_PROBE_IP
  bound to the network's interface, so a probe only succeeds if that network has
  its own way out; plus a DNS lookup of DNS_PROBE.

  FAIL  DNS fails; NET_INTERNET (mgmt) cannot fetch the URL
  WARN  any other network reaches the internet
  INFO  no ICMP reply on NET_INTERNET (often filtered)
  Needs setup.env, SSH
EOF
    ;;
    undercluster:encap) cat <<'EOF'
encap - kernel encapsulation for the Kube-OVN overlay

  Checks that geneve, vxlan and openvswitch are loaded or loadable, then builds a
  real tunnel (kubeOVN.tunnelType, default Geneve) between the first two nodes with
  an overlay address, on UDP ENCAP_TEST_PORT (6090, away from Kube-OVN's 6081):
    ip link add kvtest0 type geneve id 4242 remote <peer> dstport 6090
  pings across 169.254.250.0/30, then deletes the device.

  FAIL  tunnel-type or openvswitch module missing on an overlay node; no traffic
  WARN  the other encapsulation module missing
  Needs setup.env, SSH; creates kvtest0 for a few seconds
EOF
    ;;
    kmetal:platform) cat <<'EOF'
platform - KMetal resource and its components

  Reads the KMetal resource (kubectl get km): READY and VERSION columns, then every
  .status.components[] entry; non-Ready components are listed with their message.

  FAIL  no KMetal resource; READY != True; a component not Ready
  WARN  no components reported
  Needs kubeconfig
EOF
    ;;
    kmetal:operator) cat <<'EOF'
operator - kmetal-operator release, version and Flux delivery

  Finds the operator as the Helm release kmetal-operator in kmetal-operator-system,
  or else as a Flux HelmRelease in kmetal-flux (GitOps install). Checks its pods,
  every HelmRelease, Kustomization and OCIRepository in kmetal-flux, and pods
  anywhere in the cluster.

  PASS  Helm release deployed, or Flux HelmRelease present
  FAIL  operator not found; operator pods not ready; a Flux object not Ready
  WARN  chart version not 1.0.x; pods outside Running/Completed elsewhere
  Needs kubeconfig
EOF
    ;;
    kmetal:metallb) cat <<'EOF'
metallb - address pools, advertisement, speakers and a live allocation

  Each loadBalancer.tenantControlPlanes / management range must equal an
  IPAddressPool entry in kmetal-metallb, advertised by an L2Advertisement. Every
  control plane should run a Ready speaker. Smoke test: a LoadBalancer Service
  pinned to each pool must get an address in range and answer HTTP (from this
  machine, else from a control plane over SSH).

  FAIL  range not in a pool; pool not advertised; no address or out of range
  WARN  no speaker on a control plane; address does not answer HTTP
  Needs kubeconfig; setup.env optional; creates a temporary namespace
EOF
    ;;
    kmetal:storage) cat <<'EOF'
storage - storage classes, snapshots and live volumes

  underclusterClassName and tenantClassName must exist and differ, etcdClassName
  exists if set. The VolumeSnapshotClass must use the platform class's driver and
  the CDI StorageProfile must name it. Smoke tests: per class, a 1 Gi PVC and a
  write/read pod placed where the real consumer runs (compute nodes; spec.placement
  for etcd); then snapshot the platform volume, restore it and WRITE to the copy.

  FAIL  class missing; no snapshot class; empty StorageProfile snapshotClass;
        PVC/pod or snapshot fails; restore not writable with cloneStrategy=snapshot
  WARN  same class names; no volume expansion; restore not writable otherwise
  Needs kubeconfig; creates a temporary namespace
EOF
    ;;
    kmetal:nodes) cat <<'EOF'
nodes - node labels and Kube-OVN central nodes (kMetal 1.0.0 sets none of them)

  Control planes: no node.kubernetes.io/exclude-from-external-load-balancers.
  Compute: node-role.kubernetes.io/compute, with a Ready virt-handler.
  Network nodes (kmetal.io/ovn, never control planes): ovn.kubernetes.io/external-gw
  =true, a Ready kube-ovn-cni, and the tunnelInterface (over SSH with setup.env).
  centralNodes: each labelled kube-ovn/role=master; ideally the three control planes.

  FAIL  exclusion label on a control plane; no compute or network node; missing
        external-gw, kube-ovn-cni, tunnel interface or kube-ovn/role=master
  WARN  kmetal.io/ovn on a control plane; a worker in centralNodes; fewer than three
        control planes used while available; fewer than 3 or an even number of
        central nodes; kube-ovn/role=master outside centralNodes
  Needs kubeconfig; setup.env optional
EOF
    ;;
    kmetal:providers) cat <<'EOF'
providers - every provider network of the KMetal resource

  Compares spec.networking.providerNetworks with setup.env PROVIDER_NETWORKS by
  interface: shared ones are the defaults, the others are additional networks
  managed by the platform. For each: defaultProviderSubnet exists, subnets are
  canonical with the gateway inside, no overlap with pod, service, join, node or
  other provider networks; over SSH, the interface exists on every network node not
  in excludeNodes, has carrier and no IPv4.

  FAIL  bad subnet or overlap; interface missing or carrying IPv4; VLAN differs
        from PROV_VLAN; no network node left after excludeNodes
  WARN  unknown excludeNodes entry; double VLAN tagging; setup.env provider not
        in the KMetal resource
  Needs kubeconfig; setup.env for the SSH part
EOF
    ;;
    kmetal:tenancy) cat <<'EOF'
tenancy - Capsule enforcement for multiTenancy.users

  spec.multiTenancy.users must be set and a CapsuleConfiguration must exist. Probe:
  create a namespace while impersonating a member of the first subject who owns no
  Tenant; Capsule must reject it.

  PASS  the namespace is rejected
  FAIL  no CapsuleConfiguration; namespace created without a tenant label
  WARN  multiTenancy.users empty (tenancy inactive)
  Needs kubeconfig (impersonation)
EOF
    ;;
    kmetal:capi) cat <<'EOF'
capi - Cluster API providers and ClusterClasses

  In kmetal-capi-providers: one core (cluster-api), bootstrap (kubeadm),
  infrastructure (kubevirt) and control-plane (kamaji) provider, each Ready, and
  at least one ClusterClass; shows the one the end-to-end tests will use.

  FAIL  provider missing or not Ready; no ClusterClass; E2E_CLUSTERCLASS missing
  Needs kubeconfig
EOF
    ;;
    kmetal:kubevirt) cat <<'EOF'
kubevirt - virtualisation stack

  KubeVirt in system-kubevirt and CDI must report phase Deployed.

  FAIL  KubeVirt not Deployed
  WARN  CDI not Deployed
  Needs kubeconfig
EOF
    ;;
    kmetal:crds) cat <<'EOF'
crds - tenant-facing APIs and golden OS images

  The CRDs tenants rely on (clusters, kamajicontrolplanes, virtualmachines, the
  network.kmetal.io claims and providernetworks, Capsule tenants, volumesnapshots,
  osartifacts) exist. For every spec.clusterClass.values.osArtifact.tags entry, an
  OSArtifact in kmetal-image-builder is Ready and its <name>-golden PVC is Bound.

  FAIL  CRD missing; no tags; a tag without a usable golden image
  Needs kubeconfig
EOF
    ;;
    kmetal:e2e) cat <<'EOF'
e2e - one tenant, two environments on the same CIDR

  Creates tenant kv-<id> and, as its owner, environments kv-<id>-a / -b, each with
  a VpcClaim (external access) and a SubnetClaim on E2E_SUBNET_CIDR, and a tenant
  cluster in each (2 and 1 workers) from the osArtifact image. Then: nodes Ready,
  a PVC backed by tenantClassName, internet egress, cross-node pod traffic, an EIP
  bound to a LoadBalancer Service, and VPC isolation probed both ways.
  Cleaned up on exit; skipped after earlier failures unless --force-e2e.

  FAIL  any step above fails, or one environment reaches the other's workers
  WARN  workers on one host; EIP not reachable from EIP_PROBE_FROM
  Needs kubeconfig; ~3 VMs, 2 tenant-pool + 3 provider addresses; 20-40 min
EOF
    ;;
    kmetal:e2e-tenants) cat <<'EOF'
e2e-tenants - multi-tenancy segregation between two tenants

  Creates tenants kv-<id>-t1 / -t2, each with one environment, a VpcClaim and a
  SubnetClaim on the SAME E2E_SUBNET_CIDR, and a tenant cluster (1 and 2 workers).
  Probes, as each owner, ten actions on the other tenant (pods, secrets, its
  kubeconfig, clusters, claims, namespace, Tenant) with `kubectl auth can-i`.
  Then: nodes Ready, egress per tenant, and traffic isolation probed both ways.
  Runs in parallel with e2e; cleaned up on exit.

  FAIL  an owner is allowed any action on the other tenant; one tenant reaches the
        other's workers; setup, cluster or egress failure
  WARN  an owner cannot even read its own environment
  Needs kubeconfig; ~3 VMs, 2 tenant-pool + 2 provider addresses
EOF
    ;;
    *) return 1 ;;
    esac
}

# show_help COMMAND [GROUP]
show_help() {
    local cmd=$1 group=${2:-} groups g
    case $cmd in
        undercluster) groups=$UC_GROUPS ;;
        kmetal)       groups=$KM_GROUPS ;;
        *) usage; return 0 ;;
    esac
    if [[ -n $group ]]; then
        group_help "$cmd" "$group" ||
            die "unknown $cmd check group '$group'; groups: $groups"
        return 0
    fi
    case $cmd in
        undercluster) printf '%s\n\n' "kmetal-validate undercluster - compare the nodes with setup.env over SSH (sudo)" ;;
        kmetal)       printf '%s\n\n' "kmetal-validate kmetal - platform checks and end-to-end tests against the under cluster API" ;;
    esac
    printf 'Check groups, in execution order:\n'
    for g in $groups; do
        printf '  %-13s %s\n' "$g" "$(group_help "$cmd" "$g" | head -n1 | sed 's/^[^ ]* - //')"
    done
    printf '\nDetails: kmetal-validate %s help <group>\n' "$cmd"
    printf 'Select:  kmetal-validate %s --only g1,g2 | --skip g1,g2\n' "$cmd"
}

# ===========================================================================
# main
# ===========================================================================
ENV_FILE=./setup.env ENV_FILE_SET=0 ONLY="" SKIP="" CLUSTER_TIMEOUT=30m
NO_E2E=0 E2E_ONLY=0 FORCE_E2E=0 CLEAN_RUN_ID="" CMD="" WANT_HELP=0 POS=()
while (($#)); do
    case $1 in
        -e|--env)          ENV_FILE=${2:?}; ENV_FILE_SET=1; shift ;;
        --kubeconfig)      export KUBECONFIG=${2:?}; shift ;;
        --only)            ONLY=${2:?}; shift ;;
        --skip)            SKIP=${2:?}; shift ;;
        --keep)            KEEP=1 ;;
        --timeout-cluster) CLUSTER_TIMEOUT=${2:?}; shift ;;
        --no-e2e)          NO_E2E=1 ;;
        --e2e-only)        E2E_ONLY=1 ;;
        --force-e2e)       FORCE_E2E=1 ;;
        --run-id)          CLEAN_RUN_ID=${2:?}; shift ;;
        -v|--verbose)      DEBUG=true ;;
        -h|--help)         WANT_HELP=1 ;;
        -*) usage >&2; die "unknown option: $1" ;;
        *)  POS+=("$1") ;;
    esac
    shift
done
[[ ${DEBUG:-} == true ]] && set -x

# Positional words: <command> [help [group]] | help [command [group]]
HELP_CMD="" HELP_GROUP=""
CMD=${POS[0]:-}
case $CMD in
    help)
        CMD=help HELP_CMD=${POS[1]:-} HELP_GROUP=${POS[2]:-} ;;
    undercluster|kmetal)
        if [[ ${POS[1]:-} == help ]]; then
            CMD=help HELP_CMD=${POS[0]} HELP_GROUP=${POS[2]:-}
        elif ((WANT_HELP)); then
            CMD=help HELP_CMD=${POS[0]} HELP_GROUP=${POS[1]:-}
        elif ((${#POS[@]} > 1)); then
            die "unexpected argument: ${POS[1]} (group help: kmetal-validate $CMD help ${POS[1]})"
        fi ;;
    ""|cleanup|check-env|selftest|version)
        ((${#POS[@]} <= 1)) || { usage >&2; die "unexpected argument: ${POS[1]}"; }
        ((WANT_HELP)) && CMD=help ;;
    *) usage >&2; die "unknown command: $CMD" ;;
esac

case $CMD in
    "")      usage; exit 0 ;;
    help)    show_help "$HELP_CMD" "$HELP_GROUP"; exit 0 ;;
    version) echo "kmetal-validate $SCRIPT_VERSION (kMetal $TARGET_KMETAL)"; exit 0 ;;
esac

((BASH_VERSINFO[0] >= 4)) || die "bash >= 4 required"

if [[ -f $ENV_FILE ]]; then
    # shellcheck source=/dev/null
    source "$ENV_FILE" || die "cannot load $ENV_FILE"
    load_env
elif ((ENV_FILE_SET)); then
    die "env file $ENV_FILE not found"
fi

RUN_ID=$(printf '%05d' $(( (RANDOM * 32768 + RANDOM) % 100000 )))
WORK=$(mktemp -d "${TMPDIR:-/tmp}/kmetal-validate.XXXXXX")
chmod 700 "$WORK"
trap on_exit EXIT
trap 'printf "\n"; warn "interrupted"; exit 130' INT TERM

printf '%skmetal-validate %s%s  command=%s  run=%s  env=%s\n' "$C_B" "$SCRIPT_VERSION" "$C_0" \
    "$CMD" "$RUN_ID" "$( ((HAVE_ENV)) && echo "$ENV_FILE" || echo none)"

case $CMD in
    undercluster) cmd_undercluster ;;
    kmetal)       cmd_kmetal ;;
    cleanup)      cmd_cleanup ;;
    check-env)    ((HAVE_ENV)) || die "no setup.env (-e FILE)"; print_env ;;
    selftest)     cmd_selftest ;;
esac

run_cleanup
summary
exit "$(exit_code)"
